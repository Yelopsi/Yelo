{
  "expo": {
    "name": "Yelo",
    "slug": "yelo-saude-mental",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yelo",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.yelopsi.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "O Yelo utiliza o Face ID para permitir que você acesse sua conta com rapidez e máxima segurança."
      }
    },
    "android": {
      "package": "br.com.yelopsi.app",
      "adaptiveIcon": {
        "backgroundColor": "#1B4332",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B4332",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 100
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O Yelo utiliza o Face ID para permitir que você acesse sua conta com rapidez e máxima segurança."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
