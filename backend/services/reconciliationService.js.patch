+
+    static async autoFixStatuses(runId) {
+        try {
+            console.log("[RECONCILIATION] Executando Auto-Fix de Status...");
+            const asaasData = await this.fetchAsaas('/subscriptions?status=ACTIVE&limit=100');
+            const asaasSubs = asaasData.data || [];
+
+            const psis = await db.Psychologist.findAll({ where: { deletedAt: null } });
+            let truePayingIds = new Set();
+
+            for (const sub of asaasSubs) {
+                let localPsi = null;
+                if (sub.externalReference) localPsi = psis.find(p => String(p.id) === String(sub.externalReference));
+                if (!localPsi) localPsi = psis.find(p => p.subscriptionId === sub.id);
+                if (!localPsi && sub.customer) {
+                    try {
+                        const cData = await this.fetchAsaas(`/customers/${sub.customer}`);
+                        if (cData && cData.email) localPsi = psis.find(p => p.email.toLowerCase() === cData.email.toLowerCase());
+                    } catch (e) {}
+                }
+                if (!localPsi) continue;
+
+                try {
+                    const pData = await this.fetchAsaas(`/payments?subscription=${sub.id}`);
+                    const payments = pData.data || [];
+                    const hasPaid = payments.some(p => p.status === 'RECEIVED' || p.status === 'CONFIRMED');
+                    const hasOverdue = payments.some(p => p.status === 'OVERDUE');
+
+                    if (hasPaid && !hasOverdue) {
+                        truePayingIds.add(localPsi.id);
+                        const nextDueDate = new Date(sub.nextDueDate);
+                        nextDueDate.setDate(nextDueDate.getDate() + 3);
+                        
+                        if (localPsi.status !== 'active' || localPsi.subscriptionId !== sub.id) {
+                            await localPsi.update({ status: 'active', subscriptionId: sub.id, planExpiresAt: nextDueDate });
+                        }
+                    }
+                } catch (e) {}
+            }
+
+            const now = new Date();
+            for (const psi of psis) {
+                if (psi.is_exempt || psi.isAdmin) continue;
+
+                if (!truePayingIds.has(psi.id)) {
+                    let updateData = {};
+                    if (psi.subscriptionId) updateData.subscriptionId = null;
+                    
+                    const expDate = psi.planExpiresAt ? new Date(psi.planExpiresAt) : null;
+                    if (!expDate || expDate < now) {
+                        if (psi.status !== 'inactive') {
+                            updateData.status = 'inactive';
+                        }
+                    }
+                    
+                    if (Object.keys(updateData).length > 0) {
+                        await psi.update(updateData);
+                    }
+                }
+            }
+            console.log("[RECONCILIATION] Auto-Fix de Status concluído.");
+        } catch (error) {
+            console.error('[RECONCILIATION] Erro em autoFixStatuses:', error);
+        }
+    }
 }
 
