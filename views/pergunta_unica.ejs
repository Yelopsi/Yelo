<!DOCTYPE html>
<html lang="pt-br">
<head>
    <!-- SEO INJETADO NO SERVIDOR (VIA IA) -->
    <title><%= question.title || 'Dúvida Psicológica' %> | Yelo Comunidade</title>
    <% 
      const metaDesc = question.meta_description || (question.content 
        ? question.content.replace(/<[^>]*>?/gm, '').substring(0, 155) + '...' 
        : 'Confira as respostas dos nossos psicólogos verificados para esta dúvida na comunidade Yelo.');
      const currentUrl = `https://www.yelopsi.com.br/perguntas/${question.slug}`;
    %>
    <meta name="description" content="<%= metaDesc %>">
    <link rel="canonical" href="<%= currentUrl %>" />

    <!-- OPEN GRAPH (WhatsApp, Redes Sociais, Google Discover) -->
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= question.title || 'Dúvida Psicológica' %> | Yelo">
    <meta property="og:description" content="<%= metaDesc %>">
    <meta property="og:url" content="<%= currentUrl %>">
    <meta property="og:site_name" content="Yelo">

    <!-- SCHEMA MARKUP: QAPage JSON-LD (Google Rich Snippets & IAs / GEO) -->
    <%
      const qaAnswers = (question.answers || []).map(ans => ({
        "@type": "Answer",
        "text": (ans.content || '').replace(/<[^>]*>?/gm, '').trim(),
        "dateCreated": ans.createdAt ? new Date(ans.createdAt).toISOString() : new Date().toISOString(),
        "upvoteCount": ans.curtidas || 0,
        "url": `${currentUrl}#resposta-${ans.id}`,
        "author": {
          "@type": "Person",
          "name": ans.psychologist ? ans.psychologist.nome : "Especialista Yelo",
          "jobTitle": "Psicólogo(a) Clínico(a)",
          ...(ans.psychologist && ans.psychologist.slug ? { "url": `https://www.yelopsi.com.br/${ans.psychologist.slug}` } : {})
        }
      }));

      const qaSchema = {
        "@context": "https://schema.org",
        "@type": "QAPage",
        "mainEntity": {
          "@type": "Question",
          "name": question.title || "Dúvida Psicológica",
          "text": (question.content || '').replace(/<[^>]*>?/gm, '').trim(),
          "dateCreated": question.createdAt ? new Date(question.createdAt).toISOString() : new Date().toISOString(),
          "answerCount": qaAnswers.length,
          ...(qaAnswers.length > 0 ? {
            "acceptedAnswer": qaAnswers[0],
            ...(qaAnswers.length > 1 ? { "suggestedAnswer": qaAnswers.slice(1) } : {})
          } : {})
        }
      };
    %>
    <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>" type="application/ld+json">
      <%- JSON.stringify(qaSchema) %>
    </script>

    <%- include('partials/head') %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Mulish:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --fonte-titulo: 'Lora', serif;
            --fonte-corpo: 'Mulish', sans-serif;
        }
        body { font-family: var(--fonte-corpo); background-color: #fdfaf6; }
        h1, h2, h3 { font-family: var(--fonte-titulo); font-weight: 600; color: #1B4332; }
        
        .qna-single-container { max-width: 800px; margin: 120px auto 60px; padding: 0 20px; min-height: 60vh; }
        .question-box { background: #fff; padding: 30px; border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 40px; border: 1px solid #eee; }
        .question-box h1 { font-size: 1.8rem; margin-top: 0; margin-bottom: 15px; line-height: 1.3; }
        .question-box p { font-size: 1.1rem; line-height: 1.6; color: #444; white-space: pre-wrap; margin: 0; }
        .question-author { text-align: right; font-size: 0.85rem; color: #888; margin-top: 20px; font-style: italic; }
        
        .answer-box { background: #E6F4F1; padding: 25px; border-radius: 16px; margin-bottom: 20px; border-left: 4px solid #1B4332; }
        .psy-header { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; flex-wrap: wrap; }
        .psy-header img { width: 50px; height: 50px; border-radius: 50%; object-fit: cover; background: #fff; border: 2px solid #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .psy-info h4 { margin: 0; font-size: 1.1rem; color: #1B4332; }
        .psy-info span { font-size: 0.85rem; color: #555; }
        .answer-content { font-size: 1.05rem; line-height: 1.6; color: #333; white-space: pre-wrap; margin: 0; }
        .btn-ver-perfil { padding: 8px 18px; background: #fff; border: 1px solid #1B4332; color: #1B4332; border-radius: 50px; text-decoration: none; font-size: 0.85rem; font-weight: bold; transition: 0.2s; margin-left: auto; white-space: nowrap; }
        .btn-ver-perfil:hover { background: #1B4332; color: #fff; }
        
        @media (max-width: 600px) {
            .btn-ver-perfil { margin-left: 0; width: 100%; text-align: center; margin-top: 10px; }
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <main class="qna-single-container">
        <a href="/comunidade" style="display: inline-flex; align-items: center; gap: 5px; color: #1B4332; text-decoration: none; font-weight: bold; margin-bottom: 20px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Voltar para a Comunidade
        </a>

        <div class="question-box">
            <h1><%= question.title || 'Dúvida Psicológica' %></h1>
            <p><%= question.content %></p>
            <div class="question-author">Enviado por: <%= question.Patient ? question.Patient.nome : 'Anônimo' %></div>
        </div>

        <h3 style="margin-bottom: 20px;">Respostas dos Especialistas (<%= question.answers ? question.answers.length : 0 %>)</h3>

        <% if (question.answers && question.answers.length > 0) { %>
            <% question.answers.forEach(function(resposta) { %>
                <div class="answer-box" id="resposta-<%= resposta.id %>">
                    <div class="psy-header">
                        <img src="<%= resposta.psychologist && resposta.psychologist.fotoUrl ? resposta.psychologist.fotoUrl : 'https://placehold.co/50x50/1B4332/FFFFFF?text=Psi' %>" alt="Foto Psicólogo">
                        <div class="psy-info">
                            <h4>Psi. <%= resposta.psychologist ? resposta.psychologist.nome : 'Especialista Yelo' %></h4>
                            <span>CRP: <%= resposta.psychologist ? resposta.psychologist.crp : 'Verificado' %></span>
                        </div>
                        <% if (resposta.psychologist && resposta.psychologist.slug) { %>
                            <a href="/<%= resposta.psychologist.slug %>?utm_source=qna_answer&utm_medium=verified_badge" class="btn-ver-perfil">Ver perfil profissional</a>
                        <% } %>
                    </div>
                    <div class="answer-content"><p><%= resposta.content %></p></div>
                </div>
            <% }); %>
        <% } else { %>
            <div style="text-align: center; padding: 40px; background: #fff; border-radius: 16px; border: 1px dashed #ccc;">
                <p style="color: #666; margin: 0;">Esta pergunta ainda não foi respondida por nossos especialistas.</p>
            </div>
        <% } %>

        <!-- CTA DE MATCH COM PSICÓLOGO ESPECIALISTA -->
        <div style="background: linear-gradient(135deg, #1B4332 0%, #0f2b20 100%); color: white; padding: 35px 25px; border-radius: 16px; margin: 40px 0 25px 0; text-align: center; box-shadow: 0 10px 25px rgba(27,67,50,0.15); position: relative; overflow: hidden;">
            <div style="position: absolute; right: -20px; bottom: -20px; width: 120px; height: 120px; background: rgba(255,255,255,0.04); border-radius: 50%; pointer-events: none;"></div>
            <span style="background: rgba(255,255,255,0.15); color: #86efac; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1.2px; font-weight: 700; padding: 4px 12px; border-radius: 20px; display: inline-block; margin-bottom: 12px;">Atendimento Psicológico</span>
            <h2 style="font-family: var(--fonte-titulo); color: #ffffff; font-size: 1.65rem; margin: 0 0 10px 0; line-height: 1.25;">Precisa de ajuda individual para lidar com esta questão?</h2>
            <p style="color: rgba(255,255,255,0.85); font-size: 1rem; max-width: 600px; margin: 0 auto 22px auto; line-height: 1.6;">
                Receber uma orientação é um ótimo passo. Iniciar a psicoterapia com um especialista verificado pode transformar sua qualidade de vida com acolhimento e sigilo.
            </p>
            <a href="/questionario?utm_source=qna_cta&utm_medium=question_bottom&utm_campaign=<%= question.slug %>" style="display: inline-flex; align-items: center; gap: 8px; background: #ffffff; color: #1B4332; font-weight: 700; padding: 14px 28px; border-radius: 50px; text-decoration: none; font-size: 1rem; box-shadow: 0 4px 15px rgba(0,0,0,0.1); transition: transform 0.2s;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                Fazer Match com um Psicólogo na Yelo
            </a>
        </div>

        <!-- CTA SECUNDÁRIO: ENVIAR DÚVIDA ANÔNIMA -->
        <div class="cta-seo-perguntas" style="background: #e8f5e9; border-radius: 16px; padding: 35px 20px; text-align: center; border: 1px dashed #1B4332;">
            <h3 style="font-family: var(--fonte-titulo); color: #1B4332; font-size: 1.45rem; margin-top: 0; margin-bottom: 10px;">Também tem alguma dúvida ou angústia?</h3>
            <p style="font-size: 0.98rem; color: #444; max-width: 600px; margin: 0 auto 20px auto; line-height: 1.5;">
                Nossa comunidade é um espaço <strong>seguro, anônimo e 100% gratuito</strong>. Envie sua pergunta e receba orientações de psicólogos verificados.
            </p>
            <a href="/comunidade" class="btn-principal" style="display: inline-block; padding: 12px 26px; font-size: 0.95rem; font-weight: bold; border-radius: 50px; text-decoration: none; background: #1B4332; color: #fff;">
                Fazer uma pergunta anônima
            </a>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>