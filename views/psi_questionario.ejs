<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <%- include('partials/head') %>
    
    <title>Cadastro de Psicólogos - Yelo | Expanda sua Clínica</title>
    <meta name="description" content="Junte-se à rede Yelo. Conectamos você a pacientes que buscam sua especialidade. Gestão completa, prontuário e visibilidade.">
    <meta property="og:title" content="Seja um Psicólogo Parceiro Yelo">
    <meta property="og:description" content="Cadastre-se e receba pacientes alinhados ao seu perfil terapêutico.">
    <meta property="og:type" content="website">

    <link rel="stylesheet" href="/css/01-variables.css">
    <link rel="stylesheet" href="/style.css?v=1.6">
    <style>
        /* Feedback Visual de Seleção */
        .choice-button.selected {
            background-color: var(--cor-Yelo) !important;
            color: var(--verde-escuro) !important;
            border-color: var(--verde-escuro) !important;
            font-weight: bold;
        }
        /* Centralizar Títulos e Subtítulos */
        .slide-header {
            text-align: center;
        }
    </style>
</head>
<body class="pagina-questionario">
    <main class="questionario-container">
        <div class="progress-bar">
            <div class="progress-bar-fill"></div>
        </div>
        <div class="slides-container">
            <!-- Os slides do questionário de profissionais serão inseridos aqui -->
        </div>
    </main>
    <script src="https://unpkg.com/imask"></script>
    <script src="/config.js?v=1.6"></script>
    <script src="/js/script.js?v=1.6"></script>
    <script src="/js/profissionais.js?v=1.6"></script>
</body>
</html>