                        <div id="reviews-list-container" style="display: flex; gap: 15px; padding-bottom: 15px;">
                            <% if (totalCombinedReviewsCount === 0) { %>
                                <p style="color: #666; font-style: italic; width: 100%;">Este profissional ingressou recentemente. Se você já conhece o trabalho, seja o primeiro a deixar um depoimento!</p>
                            <% } else { %>
                                <% 
                                    // Avaliações da Yelo (com texto primeiro)
