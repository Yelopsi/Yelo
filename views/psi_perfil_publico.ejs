                                            <% } %>
                                            <div>
                                                <h4 style="margin: 0; font-family: var(--font-principal); color: #1e293b; font-size: 0.95rem; font-weight: 600;"><%= gRev.author_name %></h4>
                                                <span style="font-size: 0.75rem; color: #64748b;"><%= gRev.relative_time_description || 'recentemente' %></span>
                                            </div>
                                        </div>
                                        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 3px;">
                                            <div style="color: #f59e0b; font-size: 0.85rem;">
                                                <% for (let i = 1; i <= 5; i++) { %>
                                                    <span style="color: <%= i <= gRev.rating ? '#f59e0b' : '#cbd5e1' %>;">★</span>
                                                <% } %>
                                            </div>
                                            <span style="font-size: 0.7rem; color: #475569; background: #e2e8f0; padding: 2px 6px; border-radius: 10px; font-weight: 600; display: inline-flex; align-items: center; gap: 3px;">
                                                <svg width="10" height="10" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.34 24 12 24z"/><path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/></svg>
                                                Google
                                            </span>
                                        </div>
                                    </div>
                                    <% if (gRev.text && gRev.text.trim()) { %>
                                        <p style="margin: 0; color: #475569; font-style: italic; font-size: 0.92rem; line-height: 1.5;">"<%= gRev.text %>"</p>
