                                        <p style="margin: 0; color: #555; font-style: italic; font-size: 0.95rem; line-height: 1.5;">"<%= review.comment.trim() %>"</p>
                                    <% } else { %>
                                        <p style="margin: 0; color: #888; font-style: italic; font-size: 0.85rem; line-height: 1.4;">Avaliação sem comentário por escrito</p>
                                    <% } %>
                                </article>
                                <% }); %>

                                <% 
                                    // Avaliações do Google Meu Negócio
                                    if (hasGoogleReviews) {
                                        sortedGoogleReviews.slice(0, 4).forEach(gRev => {
                                %>
                                <article class="review-card" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; padding: 20px; width: 85vw; max-width: 350px; flex-shrink: 0; scroll-snap-align: start; cursor: pointer; transition: background 0.2s; box-sizing: border-box;" onmouseover="this.style.background = '#f0fdf4'" onmouseout="this.style.background = '#f8fafc'" onclick="document.getElementById('all-reviews-view').style.display='block'; document.body.style.overflow='hidden';">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; gap: 8px;">
