    <!-- MODAL DE AVALIAÇÃO -->
    <div id="modal-review" class="custom-modal-overlay" style="display: none; z-index: 200000;">
        <div class="custom-modal-box" style="width: 90%; max-width: 500px; padding: 30px; box-sizing: border-box;">
            <div class="sheet-drag-handle"></div>
