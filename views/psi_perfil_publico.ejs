            <div id="review-form-container" class="review-form-box" style="margin-top: 0; margin-bottom: 0;">
                <div class="review-form-header" style="margin-bottom: 20px; display: flex; flex-direction: column; align-items: center; text-align: center;">
                    <h4 class="review-form-title" style="margin: 0; font-size: 1.4rem; color: #1B4332;">Deixe sua avaliação</h4>
                    <div class="google-validation-badge" style="margin-top: 10px;" title="Para evitar perfis falsos, todas as avaliações exigem validação do Google."><svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="16" height="16"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.7 17.74 9.5 24 9.5z"></path><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path></svg><span>Validadas pelo <strong>Google</strong></span></div>
                </div>
                <form id="form-nova-avaliacao">
                    <div class="star-rating-input" style="justify-content: center; width: 100%; margin-bottom: 15px;">
                        <input type="radio" id="star5" name="rating" value="5" /><label for="star5" title="5 estrelas">★</label>
                        <input type="radio" id="star4" name="rating" value="4" /><label for="star4" title="4 estrelas">★</label>
                        <input type="radio" id="star3" name="rating" value="3" /><label for="star3" title="3 estrelas">★</label>
                        <input type="radio" id="star2" name="rating" value="2" /><label for="star2" title="2 estrelas">★</label>
                        <input type="radio" id="star1" name="rating" value="1" /><label for="star1" title="1 estrela">★</label>
                    </div>
                    <textarea name="comentario" placeholder="Escreva como foi sua experiência (opcional)" style="width: 100%; border: 1px solid #ddd; border-radius: 12px; padding: 15px; font-family: var(--font-principal); margin-top: 15px; resize: vertical; min-height: 80px; box-sizing: border-box;"></textarea>
                    <button type="submit" style="margin: 15px auto 0 auto; display: block; width: 100%; background: var(--verde-escuro); color: white; border: none; padding: 14px 32px; border-radius: 50px; font-weight: bold; font-size: 1rem; cursor: pointer; transition: transform 0.2s; box-shadow: 0 4px 15px rgba(27,67,50,0.1);">Avaliar Profissional</button>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Repassa os dados básicos pro frontend (útil para SEO e pre-load)
        window.YELO_PROFILE_DATA = <%- JSON.stringify(psicologo) %>;
    </script>
    <script src="/js/psi_perfil_publico.js"></script>

    <script>
        // Formata a Biografia com negrito, itálico e quebras de linha após o carregamento da página
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                const bioEl = document.getElementById('psi-bio-text');
                if (bioEl && window.YELO_PROFILE_DATA && window.YELO_PROFILE_DATA.bio) {
                    let text = window.YELO_PROFILE_DATA.bio;
                    
                    // Se não tiver tags HTML (texto legado plano), aplica a formatação markdown nativa
                    if (!/<\/?[a-z][\s\S]*>/i.test(text)) {
                        text = text.replace(/'''([\s\S]*?)'''/g, '<code style="background:#f4f4f4; padding:2px 6px; border-radius:4px; font-family:monospace; color:#333; font-size:0.9em; word-break: break-word; white-space: pre-wrap;">$1</code>');
                        text = text.replace(/__([\s\S]*?)__/g, '<u>$1</u>');
                        text = text.replace(/\*([\s\S]*?)\*/g, '<strong>$1</strong>');
                        text = text.replace(/_([\s\S]*?)_/g, '<em>$1</em>');
                        text = text.replace(/~([\s\S]*?)~/g, '<del>$1</del>');
                        text = text.replace(/\n/g, '<br>');
                    }
                    
                    bioEl.innerHTML = text;
                }
            }, 200); 
        });
    </script>
</body>
</html>
