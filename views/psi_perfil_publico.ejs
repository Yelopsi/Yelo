<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <%- include('partials/head') %>
    
    <!-- Garante que a origem seja enviada corretamente para o Google Sign-In -->
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <script nonce="<%= nonce %>" src="https://accounts.google.com/gsi/client" async defer></script>

    <!-- VARIÁVEIS DE SEO -->
    <% 
      let genVal = psicologo.genero_identidade;
      if (typeof genVal === 'string' && genVal.startsWith('[')) {
          try { genVal = JSON.parse(genVal)[0]; } catch(e) {}
      } else if (Array.isArray(genVal)) {
          genVal = genVal[0];
      }
      
      let profTitleBase = "Psicólogo(a)";
      let profTitle = "Psicólogo(a) Clínico(a)";
      if (genVal === 'Feminino') {
          profTitleBase = "Psicóloga";
          profTitle = "Psicóloga Clínica";
      } else if (genVal === 'Masculino') {
          profTitleBase = "Psicólogo";
          profTitle = "Psicólogo Clínico";
      } else if (genVal === 'Não-binário' || genVal === 'Outro') {
          profTitleBase = "Psicólogue";
          profTitle = "Psicólogue Clínique";
      }

      const bioSnippet = psicologo.meta_description || (psicologo.bio 
        ? psicologo.bio.replace(/<[^>]*>?/gm, '').substring(0, 155) + '...' 
        : `Encontre acolhimento e suporte com ${psicologo.nome}. ${profTitleBase} especialista em saúde mental.`);
      const currentUrl = `https://www.yelopsi.com.br/${psicologo.slug || ''}`;
      
      let imageUrl = psicologo.fotoUrl || 'https://www.yelopsi.com.br/assets/images/apple-touch-icon.png';
      if (imageUrl.includes('cloudinary.com') && imageUrl.includes('/upload/')) {
          imageUrl = imageUrl.replace('/upload/', '/upload/w_256,h_256,c_fill,q_auto/');
      }
      
      let especialidadesStr = 'Psicologia';
      if (psicologo.especialidades) {
        especialidadesStr = Array.isArray(psicologo.especialidades) 
          ? psicologo.especialidades.join(', ') 
          : psicologo.especialidades;
      }

      // --- DADOS DO GOOGLE MEU NEGÓCIO & MAPS ---
      let googleData = psicologo.google_reviews_data;
      if (typeof googleData === 'string') {
          try { googleData = JSON.parse(googleData); } catch(e) { googleData = null; }
      }
      const hasGoogleReviews = (psicologo.google_business_url || psicologo.google_place_id) && 
          googleData && 
          googleData.success && 
          !googleData.is_simulated && 
          googleData.is_live === true && 
          Array.isArray(googleData.reviews) && 
          googleData.reviews.length > 0;
      const googleReviews = hasGoogleReviews ? googleData.reviews : [];
      const sortedReviews = (reviews || []).slice().sort((a, b) => {
          const aHasText = a.comment && a.comment.trim().length > 0 ? 1 : 0;
          const bHasText = b.comment && b.comment.trim().length > 0 ? 1 : 0;
          if (aHasText !== bHasText) return bHasText - aHasText;
          return new Date(b.createdAt) - new Date(a.createdAt);
      });
      const sortedGoogleReviews = (googleReviews || []).slice().sort((a, b) => {
          const aHasText = a.text && a.text.trim().length > 0 ? 1 : 0;
          const bHasText = b.text && b.text.trim().length > 0 ? 1 : 0;
          if (aHasText !== bHasText) return bHasText - aHasText;
          return 0;
      });
      const googleRating = hasGoogleReviews && googleData.rating ? Number(googleData.rating).toFixed(1) : '5.0';
      const googleTotalCount = hasGoogleReviews ? (googleData.user_ratings_total || googleReviews.length) : 0;
      const totalCombinedReviewsCount = reviewCount + (hasGoogleReviews ? googleReviews.length : 0);

      let effectiveAggregateRating = averageRating;
      let effectiveAggregateCount = reviewCount;
      if (reviewCount === 0 && hasGoogleReviews) {
          effectiveAggregateRating = googleRating;
          effectiveAggregateCount = googleTotalCount;
      } else if (reviewCount > 0 && hasGoogleReviews) {
          const totalScore = (parseFloat(averageRating) * reviewCount) + (parseFloat(googleRating) * googleTotalCount);
          effectiveAggregateRating = (totalScore / (reviewCount + googleTotalCount)).toFixed(1);
          effectiveAggregateCount = reviewCount + googleTotalCount;
      }
    %>

    <title><%= psicologo.nome %> | <%= profTitleBase %><% if(psicologo.cidade) { %> em <%= psicologo.cidade %><% } else { %> Online<% } %> | Yelo</title>
    <meta name="description" content="<%= bioSnippet %>">
    <link rel="canonical" href="<%= currentUrl %>">

    <!-- OPEN GRAPH (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="profile">
    <meta property="og:title" content="<%= psicologo.nome %> | <%= profTitleBase %> na Yelo">
    <meta property="og:description" content="<%= bioSnippet %>">
    <meta property="og:url" content="<%= currentUrl %>">
    <meta property="og:image" content="<%= imageUrl %>">
    <!-- Força formato pequeno e arredondado no WhatsApp -->
    <meta property="og:image:width" content="256">
    <meta property="og:image:height" content="256">
    <meta property="og:image:type" content="image/jpeg">
    <!-- SCHEMA MARKUP: JSON-LD (Google) -->
    <script nonce="<%= nonce %>" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Physician",
      "name": "<%= psicologo.nome.replace(/"/g, '\\"') %>",
      "description": "<%= bioSnippet.replace(/"/g, '\\"') %>",
      "image": "<%= imageUrl %>",
      "url": "<%= currentUrl %>",
      "knowsAbout": "<%= especialidadesStr.replace(/"/g, '\\"') %>"
      <% if (effectiveAggregateCount > 0) { %>
      ,"aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "<%= effectiveAggregateRating %>",
        "reviewCount": "<%= effectiveAggregateCount %>"
      }
      <% } %>
    }
    </script>
    
    <link rel="stylesheet" href="/css/psi_dashboard.css">
    <style>
        /* ==========================================================================
           GARANTIA DE SCROLL NATIVO NO MOBILE (ANDROID, SAMSUNG INTERNET E IOS)
           Mantém a escala compacta original (70%) e a liberdade total de rolagem.
           ========================================================================== */
        html {
            font-size: 70% !important; /* Preserva a proporção e elegância dos textos e ícones */
            position: static !important;
            width: 100% !important;
            height: auto !important;
            min-height: 100% !important;
            max-height: none !important;
            overflow-x: clip;
            overflow-y: visible;
        }

        body.pagina-publica {
            position: static !important;
            width: 100% !important;
            max-width: 100% !important;
            height: auto !important;
            min-height: 100% !important;
            max-height: none !important;
            overflow-x: clip;
            overflow-y: visible;
            margin: 0 !important;
            padding: 0 !important;
            zoom: 1 !important;
        }


        /* Cores do CTA Verde Oficial Yelo (#1B4332) */
        .btn-principal, 
        a.btn-principal, 
        button.btn-principal,
        .mobile-sticky-cta .btn-principal {
            background-color: var(--verde-escuro, #1B4332) !important;
            background: var(--verde-escuro, #1B4332) !important;
            color: #ffffff !important;
            border: none !important;
            border-radius: 50px !important;
            font-weight: 700 !important;
            text-decoration: none !important;
            box-shadow: 0 4px 15px rgba(27, 67, 50, 0.2) !important;
        }
        .btn-principal svg,
        .mobile-sticky-cta .btn-principal svg {
            color: #ffffff !important;
            stroke: #ffffff !important;
        }
        .btn-principal:hover,
        .mobile-sticky-cta .btn-principal:hover {
            background-color: #143326 !important;
            color: #ffffff !important;
        }

        .btn-secundario {
            background-color: transparent !important;
            border: 2px solid var(--verde-escuro, #1B4332) !important;
            color: var(--verde-escuro, #1B4332) !important;
        }

        /* ==========================================================================
           HEADER E CTA MOBILE ULTRA-FINOS & OTIMIZADOS P/ LEGIBILIDADE DO PERFIL
           Reduz espessura vertical do header e do rodapé fixo para dar destaque ao conteúdo
           ========================================================================== */
        body.pagina-publica header {
            padding: 8px 24px !important;
            min-height: 48px !important;
            height: 48px !important;
            box-sizing: border-box !important;
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
        }

        body.pagina-publica header .logo {
            width: 125px !important;
            height: 32px !important;
            display: block !important;
            position: relative !important;
        }

        body.pagina-publica header .logo img {
            height: 32px !important;
            width: auto !important;
            object-fit: contain !important;
        }

        body.pagina-publica header .menu-hamburguer {
            width: 24px !important;
            height: 18px !important;
            padding: 0 !important;
        }

        body.pagina-publica header .menu-hamburguer .barra {
            height: 2px !important;
        }

        body.pagina-publica header .mobile-top-links {
            gap: 12px !important;
        }

        body.pagina-publica header .mobile-top-links a {
            font-size: 13px !important;
            font-weight: 600 !important;
        }

        body.pagina-publica header .user-welcome-text {
            font-size: 13px !important;
        }

        body.pagina-publica header .user-logged-area {
            gap: 12px !important;
            margin-left: 12px !important;
        }

        body.pagina-publica header .btn,
        body.pagina-publica header .botoes-acao .btn,
        body.pagina-publica header .user-logged-area .btn {
            font-size: 12.5px !important;
            padding: 5px 14px !important;
            min-height: 30px !important;
            line-height: 1.2 !important;
            border-radius: 50px !important;
        }

        body.pagina-publica header nav a {
            font-size: 14px !important;
        }

        body.pagina-publica .profile-page-main {
            padding-top: 60px !important;
        }

        @media (max-width: 768px) {
            body.pagina-publica header {
                padding: 6px 16px !important;
                min-height: 44px !important;
                height: 44px !important;
            }

            body.pagina-publica header .logo {
                width: 110px !important;
                height: 28px !important;
            }

            body.pagina-publica header .logo img {
                height: 28px !important;
            }

            body.pagina-publica .profile-page-main {
                padding-top: 52px !important;
            }

            .mobile-sticky-cta {
                padding: 8px 16px calc(10px + env(safe-area-inset-bottom, 10px)) 16px !important;
                gap: 6px !important;
                border-top-left-radius: 18px !important;
                border-top-right-radius: 18px !important;
            }

            .mobile-sticky-cta .btn-principal {
                padding: 10px 16px !important;
                min-height: 42px !important;
                font-size: 0.95rem !important;
            }
        }

        /* ==========================================================================
           MODAIS UNIVERSAIS NA PÁGINA PÚBLICA (FIX DEFINITIVO P/ SAMSUNG E ANDROID)
           Garante que o modal de avaliação e outros abram com altura 100% da tela real,
           neutralizando o zoom: 0.88 herdado de psi_dashboard.css.
           ========================================================================== */
        .custom-modal-overlay {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100% !important;
            height: 100% !important;
            height: 100dvh !important;
            max-height: 100dvh !important;
            background: rgba(0, 0, 0, 0.5) !important;
            z-index: 200000 !important;
            backdrop-filter: blur(3px) !important;
            display: none;
            justify-content: center !important;
            align-items: center !important;
            box-sizing: border-box !important;
            overflow-y: auto !important;
            -webkit-overflow-scrolling: touch !important;
        }

        .custom-modal-overlay[style*="display: flex"] {
            display: flex !important;
        }

        .custom-modal-box {
            background: #fff;
            padding: 30px;
            border-radius: 16px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            position: relative;
            max-height: 90vh;
            max-height: 90dvh;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            box-sizing: border-box;
        }

        /* Contenção de quebras e Box Sizing seguro */
        .profile-page-main *, .profile-page-main *::before, .profile-page-main *::after {
            box-sizing: border-box;
        }
        .profile-page-main .bio-text, .profile-page-main .practices-container {
            overflow-wrap: break-word;
            word-break: break-word;
        }

        /* --- Ajustes Estruturais para Desktop (Evita vazamento lateral) --- */
        @media (min-width: 993px) {
            html, body.pagina-publica {
                overflow-x: clip !important;
                overflow-y: visible !important;
            }
            .container {
                width: 100%;
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 30px;
            }
            .profile-header-grid {
                display: grid;
                grid-template-columns: minmax(0, 1fr) 360px;
                gap: 40px;
                align-items: start;
            }
            .conversion-card-wrapper {
                display: block !important;
                position: -webkit-sticky !important;
                position: sticky !important;
                top: 100px !important;
                align-self: start !important;
                z-index: 10 !important;
            }
            .mobile-only-badge { display: none !important; }
            .desktop-only-badge { display: inline-flex !important; }
        }

        /* --- Ajustes Estruturais para Mobile / Tablets --- */
        @media (max-width: 992px) {
            html {
                font-size: 70% !important;
                position: static !important;
                width: 100% !important;
                height: auto !important;
                min-height: 100% !important;
                max-height: none !important;
                overflow-x: hidden !important;
                overflow-y: auto !important;
                -webkit-overflow-scrolling: touch !important;
                overscroll-behavior-y: auto !important;
                touch-action: pan-y !important;
            }
            body.pagina-publica {
                position: static !important;
                width: 100% !important;
                max-width: 100% !important;
                height: auto !important;
                min-height: 100% !important;
                max-height: none !important;
                overflow-x: hidden !important;
                overflow-y: visible !important;
                -webkit-overflow-scrolling: touch !important;
                overscroll-behavior-y: auto !important;
                touch-action: pan-y !important;
                margin: 0 !important;
                padding: 0 !important;
                zoom: 1 !important;
            }
            .desktop-only-badge { display: none !important; }
            .mobile-only-badge { display: inline-flex !important; }
            .container {
                width: 100% !important;
                max-width: 100% !important;
                padding: 0 10px !important;
                box-sizing: border-box !important;
            }
            .profile-header-grid {
                display: flex !important;
                flex-direction: column !important;
                width: 100% !important;
                gap: 30px !important;
            }
            .profile-info-column, .conversion-card-wrapper {
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
            }
            .profile-info-card, .conversion-card-modern {
                padding: 20px 15px !important;
                width: 100% !important;
                box-sizing: border-box !important;
            }
            .conversion-card-details {
                padding: 15px 10px !important;
            }
            #all-reviews-list-container {
                padding: 15px !important;
            }
            /* --- Bottom Sheet Responsivo para Mobile & Samsung Android --- */
            .custom-modal-overlay {
                align-items: flex-end !important;
                justify-content: center !important;
                padding: 0 !important;
                height: 100% !important;
                height: 100dvh !important;
                max-height: 100dvh !important;
                bottom: 0 !important;
                top: 0 !important;
                left: 0 !important;
                right: 0 !important;
                overflow: hidden !important;
            }
            .custom-modal-box {
                width: 100% !important;
                max-width: 100% !important;
                margin: auto 0 0 0 !important;
                border-radius: 24px 24px 0 0 !important;
                max-height: 86dvh !important;
                max-height: 86vh !important;
                overflow-y: auto !important;
                -webkit-overflow-scrolling: touch !important;
                overscroll-behavior-y: contain !important;
                padding: 24px 20px calc(42px + env(safe-area-inset-bottom, 24px)) 20px !important;
                box-sizing: border-box !important;
                box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.25) !important;
                animation: slideUpSheet 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
            }
            .sheet-drag-handle {
                display: block !important;
                width: 44px !important;
                height: 5px !important;
                background: #cbd5e1 !important;
                border-radius: 3px !important;
                margin: -8px auto 18px auto !important;
            }
            #modal-review textarea[name="comentario"] {
                resize: none !important;
                font-size: 15px !important;
                min-height: 75px !important;
            }
            #modal-review button[type="submit"] {
                min-height: 48px !important;
                font-size: 1.05rem !important;
                padding: 14px 24px !important;
                margin-top: 15px !important;
                margin-bottom: 5px !important;
                touch-action: manipulation !important;
            }
            .conversion-card-wrapper {
                position: static !important;
                margin-top: 0px;
                z-index: 1 !important;
            }
        }
        #reviews-list-container {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            touch-action: pan-x pan-y;
            width: 100%;
            box-sizing: border-box;
        }
        #reviews-list-container::-webkit-scrollbar {
            display: none;
        }
        @keyframes scrollWheelYelo {
            0% { left: 4px; opacity: 1; }
            100% { left: 14px; opacity: 0; }
        }
    </style>
</head>
<body class="pagina-publica">

    <%- include('partials/header') %>

    <main id="profile-page-container" class="profile-page-main" style="display: none;">
        <div class="container">
            <div class="profile-header-grid">
                <!-- Coluna Principal (Esquerda no Desktop) -->
                <div class="profile-info-column">
                    <div class="profile-info-card">
                        
                        <!-- Cabeçalho (Foto, Nome, CRP, Avaliações) -->
                        <div class="hero-card-modern">
                            <div class="hero-photo-container">
                                <img id="psi-photo" src="<%= psicologo.fotoUrl || 'https://placehold.co/240x240/e8f5e9/1B4332?text=Psi' %>" alt="Foto de <%= psicologo.nome %>">
                            </div>
                            <div class="hero-details-container">
                                <h1 id="psi-name" class="hero-name-title">
                                    <% 
                                        if (psicologo.nome) {
                                            const nameParts = psicologo.nome.trim().split(' ');
                                            const verifiedSvg = `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.918-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.337 2.25c-.416-.165-.866-.25-1.336-.25-2.21 0-3.918 1.79-3.918 4 0 .495.084.965.238 1.4-1.273.65-2.148 2.02-2.148 3.6 0 1.46.758 2.746 1.9 3.42-.047.19-.074.385-.074.58 0 2.21 1.71 4.002 3.918 4.002.47 0 .92-.086 1.336-.25.52 1.335 1.828 2.25 3.337 2.25s2.816-.915 3.337-2.25c.416.164.866.25 1.336.25 2.21 0 3.918-1.792 3.918-4 0-.195-.027-.39-.074-.58 1.14-.675 1.9-1.96 1.9-3.42z" fill="#1B4332"/><path d="M16.97 8.47a1.5 1.5 0 0 1 0 2.12l-6.5 6.5a1.5 1.5 0 0 1-2.12 0l-3.5-3.5a1.5 1.5 0 1 1 2.12-2.12l2.44 2.44 5.44-5.44a1.5 1.5 0 0 1 2.12 0z" fill="white"/></svg>`;
                                    %>
                                        <% if (nameParts.length > 1) { %>
                                            <span class="first-name-wrapper" style="display: inline-flex; align-items: center; gap: 4px; position: relative;"><%= nameParts[0] %><span title="Psicólogo Verificado" class="hero-verified-badge mobile-only-badge" style="display: inline-flex;"><%- verifiedSvg %></span></span>
                                            <span class="name-break-mobile"><%= nameParts.slice(1).join(' ') %></span>
                                            <span title="Psicólogo Verificado" class="hero-verified-badge desktop-only-badge" style="display: inline-flex; margin-left: 4px;"><%- verifiedSvg %></span>
                                        <% } else { %>
                                            <span class="first-name-wrapper" style="display: inline-flex; align-items: center; gap: 4px; position: relative;"><%= psicologo.nome %><span title="Psicólogo Verificado" class="hero-verified-badge mobile-only-badge" style="display: inline-flex;"><%- verifiedSvg %></span></span>
                                            <span title="Psicólogo Verificado" class="hero-verified-badge desktop-only-badge" style="display: inline-flex; margin-left: 4px;"><%- verifiedSvg %></span>
                                        <% } %>
                                    <% } %>
                                </h1>
                                <% 
                                    // profTitle já foi calculado na tag <head>
                                    let abordagemText = "";
                                    let abordagens = psicologo.abordagens_tecnicas;
                                    if (typeof abordagens === 'string' && abordagens.startsWith('[')) {
                                        try { abordagens = JSON.parse(abordagens); } catch(e) {}
                                    }
                                    if (Array.isArray(abordagens) && abordagens.length > 0) {
                                        abordagemText = " | " + abordagens.join(', ');
                                    } else if (typeof abordagens === 'string' && abordagens.trim() !== '' && abordagens !== '[]') {
                                        abordagemText = " | " + abordagens;
                                    }
                                %>
                                <p id="psi-hero-subtitle" class="hero-subtitle-text"><%= profTitle %><%= abordagemText %></p>
                                
                                <!-- Resumo clicável das avaliações -->
                                <div id="psi-rating-summary" class="hero-rating-clickable" onclick="document.getElementById('reviews-section').scrollIntoView({behavior: 'smooth'})">
                                    <% if (reviewCount === 0 && !hasGoogleReviews) { %>
                                        <% 
                                            let novoText = 'Novo(a) na Yelo';
                                            if (psicologo.genero_identidade === 'Feminino') {
                                                novoText = 'Nova na Yelo';
                                            } else if (psicologo.genero_identidade === 'Masculino') {
                                                novoText = 'Novo na Yelo';
                                            } else if (psicologo.genero_identidade === 'Não-binário' || psicologo.genero_identidade === 'Outro') {
                                                novoText = 'Nove na Yelo';
                                            }
                                        %>
                                        <span style="color: #666; font-size: 0.9rem; font-weight: 600;"><%= novoText %></span>
                                    <% } else if (reviewCount === 0 && hasGoogleReviews) { %>
                                        <% 
                                            let gStarsHtml = '';
                                            const gRounded = Math.round(Number(googleRating) || 5);
                                            for (let i = 1; i <= 5; i++) {
                                                gStarsHtml += `<span style="color: ${i <= gRounded ? '#f59e0b' : '#e5e7eb'}; font-size: 1.2rem;">★</span>`;
                                            }
                                        %>
                                        <%- gStarsHtml %> <span style="color: #1e293b; font-size: 0.9rem; font-weight: 700; margin-left: 5px;"><%= googleRating %></span>
                                        <span style="display: inline-flex; align-items: center; gap: 4px; background: #f1f5f9; border: 1px solid #e2e8f0; padding: 2px 8px; border-radius: 12px; font-size: 0.78rem; font-weight: 600; color: #475569; margin-left: 6px;">
                                            <svg width="12" height="12" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.34 24 12 24z"/><path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/></svg>
                                            Google (<%= googleTotalCount %>)
                                        </span>
                                    <% } else { %>
                                        <% 
                                            let starsHtml = '';
                                            for (let i = 1; i <= 5; i++) {
                                                starsHtml += `<span style="color: ${i <= Math.round(averageRating) ? '#f59e0b' : '#e5e7eb'}; font-size: 1.2rem;">★</span>`;
                                            }
                                        %>
                                        <%- starsHtml %> <span style="color: #666; font-size: 0.9rem; font-weight: 600; margin-left: 5px;"><%= averageRating %> de 5</span>
                                        <% if (hasGoogleReviews) { %>
                                            <span style="display: inline-flex; align-items: center; gap: 4px; background: #f1f5f9; border: 1px solid #e2e8f0; padding: 2px 8px; border-radius: 12px; font-size: 0.78rem; font-weight: 600; color: #475569; margin-left: 6px;">
                                                <svg width="12" height="12" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.17z"/><path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.34 24 12 24z"/><path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/><path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.34 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/></svg>
                                                + <%= googleTotalCount %> no Google
                                            </span>
                                        <% } %>
                                    <% } %>
                                </div>
                                <% 
                                    let expTextSSR = '';
                                    let showExp = false;
                                    if (psicologo.ano_inicio_experiencia) {
                                        const currentYear = new Date().getFullYear();
                                        const anosExp = currentYear - parseInt(psicologo.ano_inicio_experiencia);
                                        if (anosExp >= 0) {
                                            showExp = true;
                                            expTextSSR = anosExp === 0 ? 'Menos de 1 ano de experiência' : `Profissional com ${anosExp} ano${anosExp > 1 ? 's' : ''} de experiência`;
                                        }
                                    }
                                    
                                    let idadeText = '';
                                    let isBirthday = false;
                                    if (psicologo.data_nascimento) {
                                        const dateStr = psicologo.data_nascimento.toString();
                                        const parts = dateStr.split('-');
                                        if (parts.length >= 3) {
                                            const birthYear = parseInt(parts[0], 10);
                                            const birthMonth = parseInt(parts[1], 10) - 1;
                                            const birthDay = parseInt(parts[2].substring(0, 2), 10);
                                            
                                            const today = new Date();
                                            let age = today.getFullYear() - birthYear;
                                            const m = today.getMonth() - birthMonth;
                                            if (m < 0 || (m === 0 && today.getDate() < birthDay)) {
                                                age--;
                                            }
                                            idadeText = `${age} anos`;
                                            
                                            if (today.getMonth() === birthMonth && today.getDate() === birthDay) {
                                                isBirthday = true;
                                            }
                                        }
                                    }
                                %>
                                <!-- Bloco de Autoridade -->
                                <div class="hero-authority-block">
                                    <div class="auth-item"><span class="auth-icon green">✓</span> <span id="psi-crp">CRP: <%= psicologo.crp %></span></div>
                                    <div class="auth-item"><span class="auth-icon blue">🔒</span> <span>Sigilo Garantido</span></div>
                                    <div id="auth-experiencia" class="auth-item" style="display: <%= showExp ? 'flex' : 'none' %>;"><span class="auth-icon gold">⭐</span> <span id="psi-experiencia-text"><%= expTextSSR %></span></div>
                                    <% if (idadeText) { %><div class="auth-item"><span class="auth-icon" style="color: #9333ea;">👤</span> <span><%= idadeText %></span></div><% } %>
                                    <% if (isBirthday) { %><div class="auth-item" style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 2px 8px; color: #b45309; font-weight: bold; font-size: 0.85rem;"><span class="auth-icon">🎉</span> Feliz Aniversário!</div><% } %>
                                </div>
                            </div>
                            <!-- INFORMAÇÕES RÁPIDAS (APENAS MOBILE) -->
                            <div class="mobile-quick-info">
                                <div class="mq-trust-row" style="flex-wrap: wrap;">
                                    <div class="mq-trust-item verified"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> <span>Verificado</span></div>
                                    <div class="mq-trust-item crp"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> <span>CRP Ativo</span></div>
                                    <div id="mq-experiencia" class="mq-trust-item" style="display: <%= showExp ? 'flex' : 'none' %>; color: #f59e0b;">⭐ <span id="mq-experiencia-text"><%= expTextSSR.replace('Profissional com ', '').replace(' de experiência', '') %></span></div>
                                </div>
                                <div class="mq-info-grid" style="width: 100%; box-sizing: border-box; overflow: hidden;">
                                    <% if (idadeText) { %>
                                    <div class="mq-info-row">
                                        <div class="mq-icon" style="background: #f3e8ff; color: #9333ea;">👤</div>
                                        <div class="mq-text-group">
                                            <span class="mq-label">Idade</span>
                                            <span class="mq-value"><%= idadeText %><% if (isBirthday) { %> <span style="color: #b45309; font-weight: bold; font-size: 0.8rem; margin-left: 5px;">🎉 Parabéns!</span><% } %></span>
                                        </div>
                                    </div>
                                    <% } %>
                                    <% const locSSR = (psicologo.cidade && psicologo.estado) ? `${psicologo.cidade}, ${psicologo.estado}` : ''; %>
                                    <% if (locSSR) { %>
                                    <div class="mq-info-row">
                                        <div class="mq-icon" style="background: #e8f5e9; color: #16a34a;">📍</div>
                                        <div class="mq-text-group">
                                            <span class="mq-label">Localização</span>
                                            <span id="psi-location-mobile" class="mq-value"><%= locSSR %></span>
                                        </div>
                                    </div>
                                    <% } %>
                                    <div class="mq-info-row">
                                        <div class="mq-icon" style="background: #e0f2fe; color: #0284c7;">💻</div>
                                        <div class="mq-text-group">
                                            <span class="mq-label">Atendimento</span>
                                            <% 
                                                let modSSR = 'Não informado';
                                                if (Array.isArray(psicologo.modalidade) && psicologo.modalidade.length > 0) {
                                                    modSSR = psicologo.modalidade.join(' // ');
                                                } else if (typeof psicologo.modalidade === 'string' && psicologo.modalidade.trim().length > 0) {
                                                    try {
                                                        const p = JSON.parse(psicologo.modalidade);
                                                        modSSR = (Array.isArray(p) && p.length > 0) ? p.join(' // ') : psicologo.modalidade;
                                                    } catch(e) {
                                                        modSSR = psicologo.modalidade;
                                                    }
                                                }
                                                if (modSSR === '[]' || modSSR === '') modSSR = 'Não informado';
                                            %>
                                            <span id="psi-modalidade-mobile" class="mq-value"><%= modSSR %></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- FIM INFORMAÇÕES RÁPIDAS MOBILE -->
                            
                        </div>

                        <!-- Bio -->
                        <div class="profile-section-modern" style="margin-bottom: 40px;">
                            <h3 class="profile-section-title">Sobre Mim</h3>
                            <p class="profile-section-subtitle">Conheça um pouco mais sobre minha trajetória e como posso te ajudar.</p>
                            <div class="bio-card">
                                <p id="psi-bio-text" class="bio-text"></p>
                            </div>
                        </div>

                        <!-- Formação Acadêmica -->
                        <div class="profile-section-modern" id="formacao-section" style="margin-bottom: 40px; display: <%= (psicologo.formacao_nivel || psicologo.formacao_desc) ? 'block' : 'none' %>;">
                            <h3 class="profile-section-title">Formação Acadêmica</h3>
                            <p class="profile-section-subtitle">Minha base de conhecimento e especializações.</p>
                            <div style="display: flex; gap: 15px; align-items: flex-start;">
                                <div class="education-icon">🎓</div>
                                <div>
                                    <strong id="psi-formacao-nivel" style="display: block; font-size: 1.1rem; color: #333; margin-bottom: 5px;"><%= psicologo.formacao_nivel || 'Formação Superior' %></strong>
                                    <p id="psi-formacao-desc" style="margin: 0; font-size: 0.95rem; color: #666; line-height: 1.6;"><%= psicologo.formacao_desc || 'Sem detalhes adicionais informados.' %></p>
                                </div>
                            </div>
                        </div>

                        <!-- Especialidades e Atuação -->
                        <div class="profile-section-modern" style="margin-bottom: 40px;">
                            <h3 class="profile-section-title">Especialidades e Atuação</h3>
                            <p class="profile-section-subtitle">Áreas em que tenho maior experiência e foco de estudo.</p>
                            
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr)); gap: 25px;">
                                <div>
                                    <span class="tag-category-title">Temas de Atuação</span>
                                    <div id="psi-temas-container" class="practices-container" style="display: flex; flex-wrap: wrap; gap: 8px;"></div>
                                </div>
                                <div>
                                    <span class="tag-category-title">Público-Alvo</span>
                                    <div id="psi-publico-container" class="practices-container" style="display: flex; flex-wrap: wrap; gap: 8px;"></div>
                                </div>
                                <div>
                                    <span class="tag-category-title">Abordagem Técnica</span>
                                    <div id="psi-abordagem-container" class="practices-container" style="display: flex; flex-wrap: wrap; gap: 8px;">
                                        <% 
                                            let absList = psicologo.abordagens_tecnicas;
                                            if (typeof absList === 'string' && absList.startsWith('[')) {
                                                try { absList = JSON.parse(absList); } catch(e) {}
                                            }
                                            if (Array.isArray(absList)) {
                                                absList.forEach(tag => {
                                                    if (tag && tag.trim()) { %>
                                                        <span style="background-color: #f0fdf4; color: #166534; padding: 5px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; border: 1px solid #bbf7d0; display: inline-block; word-break: break-word; white-space: normal; box-sizing: border-box; max-width: 100%;"><%= tag.trim() %></span>
                                                    <% }
                                                });
                                            } else if (typeof absList === 'string' && absList.trim() && absList !== '[]') { %>
                                                <span style="background-color: #f0fdf4; color: #166534; padding: 5px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; border: 1px solid #bbf7d0; display: inline-block; word-break: break-word; white-space: normal; box-sizing: border-box; max-width: 100%;"><%= absList.trim() %></span>
                                            <% } %>
                                    </div>
                                </div>
                                <div>
                                    <span class="tag-category-title">Práticas Afirmativas</span>
                                    <div id="psi-praticas-container" class="practices-container" style="display: flex; flex-wrap: wrap; gap: 8px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- SEÇÃO DE AVALIAÇÕES -->
                    <div id="reviews-section" class="profile-info-card">
                        <h3 class="profile-section-title" style="font-size: 1.8rem;">Avaliações dos Pacientes <span id="review-count-wrapper" style="<% if (totalCombinedReviewsCount === 0) { %>display: none;<% } %>">(<span id="review-count"><%= totalCombinedReviewsCount %></span>)</span></h3>
                        <p style="color: #666; font-size: 0.95rem; margin: 0 0 20px 0;">Experiências e relatos de pessoas que acompanhei.</p>

                        <% if (hasGoogleReviews) { %>
                        <!-- Banner Oficial do Google Meu Negócio -->
                        <div style="display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border: 1.5px solid #e2e8f0; border-radius: 14px; padding: 12px 18px; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="width: 38px; height: 38px; border-radius: 10px; background: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(0,0,0,0.06); border: 1px solid #e2e8f0; flex-shrink: 0;">
