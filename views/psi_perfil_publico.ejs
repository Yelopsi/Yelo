<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- SEO INJETADO NO SERVIDOR -->
    <title><%= psicologo.nome %> | Psicólogo(a) na Yelo</title>
    <% 
      const bioSnippet = psicologo.bio 
        ? psicologo.bio.replace(/<[^>]*>?/gm, '').substring(0, 155) + '...' 
        : `Encontre acolhimento e suporte com ${psicologo.nome}. Psicólogo(a) especialista em saúde mental.`;
    %>
    <meta name="description" content="<%= bioSnippet %>">
    
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/css/05-pages.css">
    <link rel="stylesheet" href="/css/psi_dashboard.css">
</head>
<body class="pagina-publica">

    <%- include('partials/header') %>

    <main id="profile-page-container" class="profile-page-main" style="display: none;">
        <div class="container">
            <div class="profile-header-grid">
                <!-- Coluna Principal (Esquerda no Desktop) -->
                <div class="profile-info-column">
                    <div class="profile-info-card" style="background: #ffffff; padding: 40px; border-radius: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid #f0f0f0; margin-bottom: 30px;">
                        
                        <!-- Cabeçalho (Foto, Nome, CRP, Avaliações) -->
                        <div class="profile-hero-info" style="text-align: center; margin-bottom: 40px;">
                            <div class="profile-photo-wrapper" style="width: 180px; height: 180px; margin: 0 auto 20px auto; border-radius: 50%; padding: 5px; border: 2px dashed var(--verde-escuro);">
                                <img id="psi-photo" src="<%= psicologo.fotoUrl || 'https://placehold.co/180x180/e8f5e9/1B4332?text=Psi' %>" alt="Foto de <%= psicologo.nome %>" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                            </div>
                            <div class="profile-name-block">
                                <h1 id="psi-name" style="font-family: var(--font-titulos); font-size: 2.2rem; color: var(--verde-escuro); margin: 10px 0 5px 0;"><%= psicologo.nome %></h1>
                                <div class="badge-group" style="margin-bottom: 15px;">
                                    <span id="psi-crp" class="crp-badge" style="background: #f0fdf4; padding: 5px 15px; border-radius: 20px; color: var(--verde-escuro); font-weight: 600; font-size: 0.95rem;">CRP: <%= psicologo.crp %></span>
                                    <span id="verification-badge" class="verification-badge" title="Psicólogo Verificado" style="display: inline-block; background-color: var(--verde-escuro); color: white; border-radius: 50%; width: 20px; height: 20px; line-height: 20px; text-align: center; font-size: 0.8rem; margin-left: 5px; vertical-align: middle;">✓</span>
                                </div>
                                <!-- Resumo clicável das avaliações -->
                                <div id="psi-rating-summary" class="rating-display-hero" style="cursor: pointer; display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; background: #f8f9fa; border-radius: 50px; border: 1px solid #eee; transition: all 0.2s;" onclick="document.getElementById('reviews-section').scrollIntoView({behavior: 'smooth'})" onmouseover="this.style.background='#f0fdf4'; this.style.borderColor='#bbf7d0'" onmouseout="this.style.background='#f8f9fa'; this.style.borderColor='#eee'">
                                    <!-- Preenchido via JS -->
                                </div>
                            </div>
                        </div>

                        <!-- Bio -->
                        <div class="profile-section-modern" style="margin-bottom: 40px;">
                            <h3 style="font-family: var(--font-titulos); font-size: 1.5rem; color: var(--verde-escuro); margin: 0 0 15px 0; border-bottom: 1px solid #f0f0f0; padding-bottom: 10px;">Sobre Mim</h3>
                            <div class="bio-card" style="background-color: #f8f9fa; border-left: 4px solid var(--verde-escuro); padding: 20px 30px; border-radius: 0 12px 12px 0;">
                                <p id="psi-bio-text" class="bio-text" style="font-size: 1.05rem; line-height: 1.8; color: #444; margin: 0; text-align: justify; white-space: pre-wrap;"></p>
                            </div>
                        </div>

                        <!-- Formação Acadêmica -->
                        <div class="profile-section-modern" id="formacao-section" style="margin-bottom: 40px;">
                            <h3 style="font-family: var(--font-titulos); font-size: 1.5rem; color: var(--verde-escuro); margin: 0 0 15px 0; border-bottom: 1px solid #f0f0f0; padding-bottom: 10px;">Formação Acadêmica</h3>
                            <div style="display: flex; gap: 15px; align-items: flex-start;">
                                <div style="width: 45px; height: 45px; background: #e0f2fe; color: #0284c7; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0;">🎓</div>
                                <div>
                                    <strong id="psi-formacao-nivel" style="display: block; font-size: 1.1rem; color: #333; margin-bottom: 5px;">Carregando...</strong>
                                    <p id="psi-formacao-desc" style="margin: 0; font-size: 0.95rem; color: #666; line-height: 1.6;">Aguardando informações do perfil...</p>
                                </div>
                            </div>
                        </div>

                        <!-- Especialidades e Atuação -->
                        <div class="profile-section-modern" style="margin-bottom: 40px;">
                            <h3 style="font-family: var(--font-titulos); font-size: 1.5rem; color: var(--verde-escuro); margin: 0 0 20px 0; border-bottom: 1px solid #f0f0f0; padding-bottom: 10px;">Especialidades e Atuação</h3>
                            
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 25px;">
                                <div>
                                    <span style="font-size: 0.85rem; color: #888; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block; margin-bottom: 10px;">Temas de Atuação</span>
                                    <div id="psi-temas-container" class="practices-container" style="display: flex; flex-wrap: wrap; gap: 8px;"></div>
                                </div>
                                <div>
                                    <span style="font-size: 0.85rem; color: #888; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block; margin-bottom: 10px;">Público-Alvo</span>
                                    <div id="psi-publico-container" class="practices-container" style="display: flex; flex-wrap: wrap; gap: 8px;"></div>
                                </div>
                                <div>
                                    <span style="font-size: 0.85rem; color: #888; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block; margin-bottom: 10px;">Abordagem Técnica</span>
                                    <div id="psi-abordagem-container" class="practices-container" style="display: flex; flex-wrap: wrap; gap: 8px;"></div>
                                </div>
                                <div>
                                    <span style="font-size: 0.85rem; color: #888; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px; display: block; margin-bottom: 10px;">Práticas Afirmativas</span>
                                    <div id="psi-praticas-container" class="practices-container" style="display: flex; flex-wrap: wrap; gap: 8px;"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Redes Sociais -->
                        <div class="profile-section-modern" id="redes-sociais-section">
                            <h3 style="font-family: var(--font-titulos); font-size: 1.5rem; color: var(--verde-escuro); margin: 0 0 15px 0; border-bottom: 1px solid #f0f0f0; padding-bottom: 10px;">Redes Sociais</h3>
                            <div id="psi-social-links" class="social-share-row" style="display: flex; gap: 12px; flex-wrap: wrap;">
                                <!-- Ícones das redes injetados via JS -->
                            </div>
                        </div>
                    </div>
                    
                    <!-- SEÇÃO DE AVALIAÇÕES (Movido para fora do card, mas ainda na coluna esquerda) -->
                    <div id="reviews-section" class="profile-info-card" style="background: #fff; padding: 40px; border-radius: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid #f0f0f0;">
                        <h3 style="font-family: var(--font-titulos); font-size: 1.8rem; color: var(--verde-escuro); margin: 0 0 20px 0;">Avaliações dos Pacientes (<span id="review-count">0</span>)</h3>
                        
                        <div id="reviews-list-container" style="display: flex; flex-direction: column; gap: 15px;">
                            <!-- Lista de avaliações será inserida aqui via JS -->
                        </div>

                        <div id="review-form-container" class="review-form-box" style="margin-top: 40px; background: #f8f9fa; padding: 25px; border-radius: 16px; border: 1px solid #e9ecef;">
                            <!-- Formulário de avaliação será inserido aqui via JS -->
                        </div>
                    </div>
                </div>

                <!-- Coluna de Conversão (Direita no Desktop, Sticky) -->
                <div class="conversion-card-wrapper" style="position: sticky; top: 100px; align-self: start;">
                    <div class="conversion-card-modern" style="background: #ffffff; padding: 30px; border-radius: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.06); border: 1px solid #f0f0f0; text-align: center;">
                        
                        <h3 style="font-size: 0.95rem; color: #888; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 10px 0; font-family: var(--font-principal);">Investimento</h3>
                        
                        <div id="price-display-container">
                            <!-- Preço inserido via JS -->
                        </div>

                        <div class="conversion-card-details" style="margin: 25px 0; background: #f8f9fa; padding: 20px; border-radius: 16px; text-align: left; display: flex; flex-direction: column; gap: 15px;">
                            
                            <div class="info-row" style="display: flex; align-items: flex-start; gap: 12px;">
                                <div style="width: 32px; height: 32px; background: #e8f5e9; color: #16a34a; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0;">📍</div>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    <span style="font-size: 0.75rem; color: #888; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Localização</span>
                                    <span id="psi-location" style="font-size: 0.95rem; color: #333; font-weight: 600;">Carregando...</span>
                                </div>
                            </div>

                            <div class="info-row" style="display: flex; align-items: flex-start; gap: 12px;">
                                <div style="width: 32px; height: 32px; background: #e0f2fe; color: #0284c7; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; flex-shrink: 0;">💻</div>
                                <div style="display: flex; flex-direction: column; gap: 2px;">
                                    <span style="font-size: 0.75rem; color: #888; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Atendimento</span>
                                    <span id="psi-modalidade" style="font-size: 0.95rem; color: #333; font-weight: 600;">Carregando...</span>
                                </div>
                            </div>

                        </div>

                        <a id="btn-agendar-whatsapp" href="#" class="btn btn-principal btn-pulse" target="_blank" rel="noopener noreferrer" style="width: 100%; display: flex; justify-content: center; align-items: center; gap: 10px; padding: 16px; border-radius: 50px; font-size: 1.1rem; box-shadow: 0 6px 20px rgba(27,67,50,0.25); text-decoration: none; font-weight: 700; color: #fff;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                            Falar no WhatsApp
                        </a>
                        <p class="cta-subtitle" style="font-size: 0.85rem; color: #888; margin-top: 15px; line-height: 1.4;">Clique para iniciar uma conversa direta e tirar suas dúvidas.</p>
                        
                        <div class="trust-badges-row" style="display: flex; justify-content: center; gap: 20px; margin-top: 25px; border-top: 1px dashed #e9ecef; padding-top: 20px;">
                            <div class="trust-item" style="display: flex; flex-direction: column; align-items: center; gap: 5px; color: #16a34a;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                                <span style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: #666;">Verificado</span>
                            </div>
                            <div class="trust-item" style="display: flex; flex-direction: column; align-items: center; gap: 5px; color: #1B4332;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                <span style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: #666;">CRP Ativo</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <div id="loader-container" style="text-align: center; padding: 80px 20px;">
        <div class="loader-spinner" style="margin: 0 auto;"></div>
    </div>

    <script>
        // Repassa os dados básicos pro frontend (útil para SEO e pre-load)
        window.YELO_PROFILE_DATA = <%- JSON.stringify(psicologo) %>;
    </script>
    <script src="/js/psi_perfil_publico.js"></script>
</body>
</html>
