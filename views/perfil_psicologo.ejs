<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- SEO INJETADO NO SERVIDOR -->
    <title><%= psicologo.nome %> | Psicólogo(a) em <%= psicologo.cidade || 'Todo Brasil' %></title>
    <% 
      const bioSnippet = psicologo.bio 
        ? psicologo.bio.replace(/<[^>]*>?/gm, '').substring(0, 155) + '...' 
        : `Encontre acolhimento e suporte com ${psicologo.nome}. Psicólogo(a) especialista em saúde mental.`;
    %>
    <meta name="description" content="<%= bioSnippet %>">
    
    <!-- Links para seus arquivos CSS -->
    <!-- CORREÇÃO: Ordem e arquivos corretos para garantir que todos os estilos sejam aplicados -->
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/css/05-pages.css">
    <link rel="stylesheet" href="/css/psi_dashboard.css">

    <!-- ESTILOS INLINE PARA O LAYOUT APP-LIKE MOBILE -->
    <style>
        /* Esconde o card de conversão lateral no mobile e ajusta o grid */
        @media (max-width: 991px) {
            .profile-sidebar-content {
                display: none;
            }
            .profile-header-grid {
                grid-template-columns: 1fr; /* Garante uma coluna só no mobile */
            }
            main.profile-page-main {
                padding-bottom: 120px; /* Espaço para o CTA flutuante não cobrir o conteúdo */
            }
        }

        /* CTA Flutuante para Mobile */
        .mobile-sticky-cta {
            display: none; /* Escondido no desktop por padrão */
        }
        @media (max-width: 991px) {
            .mobile-sticky-cta {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
                position: fixed;
                bottom: 0;
                left: 0;
                width: 100%;
                background-color: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(10px);
                -webkit-backdrop-filter: blur(10px);
                padding: 15px 20px;
                padding-bottom: calc(15px + env(safe-area-inset-bottom)); /* Respeita a 'home bar' do iPhone */
                box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
                border-top: 1px solid #eee;
                z-index: 1000;
            }

            .mobile-sticky-cta .price-info { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.2; }
            .mobile-sticky-cta .price-value { font-size: 1.2rem; font-weight: 700; color: var(--verde-escuro); }
            .mobile-sticky-cta .price-label { font-size: 0.8rem; color: var(--cinza-texto); }
            .mobile-sticky-cta .btn { flex-shrink: 0; /* Impede que o botão encolha */ }
        }

        /* Animação de entrada do CTA */
        @keyframes slideUpCta {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }
    </style>

</head>
<body>
    <!-- Inclua seu header/menu principal aqui, se for um parcial -->
    <%- include('partials/header') %>

    <main class="profile-page-main">
        <div class="container">
            <div class="profile-header-grid">
                <!-- Coluna Principal (Esquerda no Desktop) -->
                <div class="profile-main-content">
                    <div class="profile-info">
                        <div class="profile-photo-wrapper">
                            <img src="<%= psicologo.fotoUrl || '/assets/images/placeholder-avatar.png' %>" alt="Foto de <%= psicologo.nome %>" class="profile-avatar-lg">
                        </div>
                        
                        <h1><%= psicologo.nome %> <span class="verification-badge" title="Profissional Verificado">✓</span></h1>
                        <span class="crp">CRP: <%= psicologo.crp %></span>
                        
                        <div class="social-links-profile">
                            <% if (psicologo.instagram_url) { %>
                                <a href="https://instagram.com/<%= psicologo.instagram_url.replace('@', '') %>" target="_blank" class="icon-social" title="Instagram">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                                </a>
                            <% } %>
                            <% if (psicologo.linkedin_url) { %>
                                <a href="https://linkedin.com/in/<%= psicologo.linkedin_url %>" target="_blank" class="icon-social" title="LinkedIn">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <div class="profile-body-tabs">
                        <nav class="tabs-nav">
                            <button class="tab-link active" data-tab="sobre">Sobre Mim</button>
                            <button class="tab-link" data-tab="especialidades">Especialidades</button>
                        </nav>
                        <div id="tab-sobre" class="tab-content active">
                            <div class="about-section-modern">
                                <div class="bio-card">
                                    <p class="bio-text"><%- psicologo.bio || 'Biografia ainda não preenchida.' %></p>
                                </div>
                            </div>
                        </div>
                        <div id="tab-especialidades" class="tab-content">
                            <% if (psicologo.temas_atuacao && psicologo.temas_atuacao.length > 0) { %>
                                <div class="practices-container">
                                    <% psicologo.temas_atuacao.forEach(tema => { %>
                                        <span class="practice-tag"><%= tema %></span>
                                    <% }); %>
                                </div>
                            <% } else { %>
                                <p>Nenhuma especialidade informada.</p>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Coluna Lateral (Direita no Desktop) -->
                <div class="profile-sidebar-content">
                    <div class="conversion-card-wrapper">
                        <div class="conversion-card-modern">
                            <% if (psicologo.valor_sessao_numero) { %>
                                <div class="price-display">R$ <%= psicologo.valor_sessao_numero.toFixed(2).replace('.', ',') %></div>
                                <span class="price-suffix">/ sessão de 50 min</span>
                            <% } %>
                            <a href="https://wa.me/<%= psicologo.telefone %>" target="_blank" id="btn-agendar-whatsapp" class="btn btn-principal btn-pulse">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                                Agendar via WhatsApp
                            </a>
                            <div class="trust-badges-row">
                                <div class="trust-item"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg><span>Pagto. Seguro</span></div>
                                <div class="trust-item"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg><span>Sigilo Garantido</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    
    <!-- CTA Flutuante para Mobile -->
    <div class="mobile-sticky-cta">
        <% if (psicologo.valor_sessao_numero) { %>
            <div class="price-info">
                <span class="price-value">R$ <%= psicologo.valor_sessao_numero.toFixed(2).replace('.', ',') %></span>
                <span class="price-label">/ sessão</span>
            </div>
        <% } %>
        <a href="https://wa.me/<%= psicologo.telefone %>" target="_blank" id="btn-agendar-whatsapp-mobile" class="btn btn-principal">Agendar Consulta</a>
    </div>

    <!-- Seus scripts JS que operam no HTML pré-renderizado -->
    <script src="/js/perfil_publico.js"></script>
</body>
</html>