    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil do Psicólogo - Yelo</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Mulish:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" href="/assets/images/favicon.png" type="image/png">

    <link rel="stylesheet" href="/css/01-variables.css"> 
    <link rel="stylesheet" href="/css/02-base.css">      
    <link rel="stylesheet" href="/css/03-layout.css">    
    <link rel="stylesheet" href="/css/04-components.css"> 

    <link rel="stylesheet" href="/css/psi_dashboard.css">
    
    <style>
        :root {
            --fonte-titulo: 'Lora', serif;
            --fonte-corpo: 'Mulish', sans-serif;
        }
        body {
            font-family: var(--fonte-corpo);
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--fonte-titulo);
            font-weight: 600;
        }
        /* Estilos Específicos Modernos para o Perfil Público */
        body {
            background-color: #FFFDF5; /* Fundo creme suave da marca */
            overflow-x: clip !important; /* IMPEDE ROLAGEM HORIZONTAL E PERMITE O STICKY FUNCIONAR */
            width: calc(100vw / 0.88) !important; /* Compensa o espaço lateral causado pelo zoom */
            max-width: none !important; /* Remove a trava que espremia a página */
            zoom: 0.88 !important; /* Mantém o zoom padrão da plataforma para o cabeçalho não ficar gigante */
        }
        html { overflow-x: clip !important; }

    /* --- CORREÇÃO DO RODAPÉ --- */
    /* O CSS do dashboard reduz a fonte base (rem) para 70%.
       Forçamos os textos do rodapé em pixels para igualar ao tamanho da Home (index). */
    .rodape-principal p,
    .rodape-principal a,
    .rodape-principal li,
    .rodape-principal span {
        font-size: 15px !important;
    }
    .rodape-principal h3,
    .rodape-principal h4 {
        font-size: 18px !important;
    }

        .profile-layout-grid {
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 40px;
            margin-top: 40px;
            align-items: start;
        }

        /* Coluna Esquerda (Conteúdo) */
        .profile-hero-card {
            background: white;
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            border: 1px solid rgba(0,0,0,0.05);
            margin-bottom: 30px;
            position: relative;
        }

        .profile-header-flex {
            display: flex;
            gap: 30px;
            align-items: flex-start;
        }

        .profile-photo-wrapper {
            flex-shrink: 0;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            overflow: hidden;
            border: 4px solid #FFEE8C; /* Amarelo Yelo */
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
        }

        .profile-photo-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-name-block h1 {
            font-family: var(--fonte-titulo);
            color: #1B4332;
            font-size: 2.2rem;
            margin: 0 0 5px 0;
            line-height: 1.1;
        }

        .crp-badge {
            display: inline-block;
            background: #e8f5e9; /* Fundo um pouco mais forte */
            color: #1B4332; /* Texto verde escuro da marca para contraste */
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.9rem; /* Levemente maior */
            font-weight: 600;
            margin-bottom: 10px;
        }

        /* Tags de Especialidades */
        .tags-container {
            display: flex;
            flex-direction: column; /* Um embaixo do outro */
            gap: 8px;
            margin-top: 15px;
        }
        .tag-pill {
            background: #f3f4f6;
            color: #4b5563;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 0.9rem;
        }

        /* --- DETALHES PROFISSIONAIS: APP-LIKE & PÍLULAS --- */
        #psi-tags-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 25px;
        }

        /* Cada bloco de categoria (Estilo Card de App) */
        #psi-tags-container > div {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            background: #ffffff;
            padding: 24px;
            border-radius: 24px;
            border: 1px solid #f3f4f6;
            box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        }

        /* Títulos de seção estilo App (iOS/Android labels) */
        #psi-tags-container h4, 
        #psi-tags-container strong {
            font-family: var(--fonte-corpo);
            font-size: 0.9rem; /* Levemente maior */
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #4b5563; /* Cinza mais escuro para contraste */
            margin-top: 0;
            margin-bottom: 16px;
            font-weight: 700;
            width: 100%;
            display: block;
        }

        /* Container das Pílulas */
        #psi-tags-container .tags-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 0;
            width: 100%;
        }

        /* Pílula Base Tátil */
        #psi-tags-container .tag-pill {
            background: #f3f4f6;
            color: #374151;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 50px; /* Pílula perfeita */
            font-size: 0.95rem;
            border: 1px solid transparent;
            transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: var(--fonte-corpo);
        }

        #psi-tags-container .tag-pill:hover {
            transform: scale(1.04);
        }

        /* --- VARIAÇÕES POR CATEGORIA --- */
        
        /* 1. Abordagem (Destaque Yelo) */
        #psi-tags-container > div:nth-child(1) .tag-pill {
            background-color: #1B4332;
            color: #FFEE8C;
        }

        /* 2. Temas de Atuação (Pílulas Outline/Claras) */
        #psi-tags-container > div:nth-child(2) .tag-pill {
            background-color: #ffffff;
            color: #1B4332;
            border: 1px solid #d1d5db;
        }
        #psi-tags-container > div:nth-child(2) .tag-pill:hover {
            border-color: #1B4332;
            background-color: #f0fdf4;
        }

        /* 3. Público-Alvo */
        #psi-tags-container > div:nth-child(3) .tag-pill {
            background-color: #e8f5e9;
            color: #166534;
        }

        /* 4. Práticas Inclusivas (Card de Acolhimento) */
        #psi-tags-container > div:nth-child(4) {
            background-color: #fffbeb;
            border: 1px solid #fde68a;
        }
        #psi-tags-container > div:nth-child(4) h4,
        #psi-tags-container > div:nth-child(4) strong {
            color: #b45309;
        }
        #psi-tags-container > div:nth-child(4) .tag-pill {
            background-color: #FFEE8C;
            color: #92400e;
        }

        /* Adaptação para Desktop (Mantendo o App-feel) */
        @media (min-width: 768px) {
            #psi-tags-container {
                display: grid;
                grid-template-columns: 1fr 1fr; /* 2 colunas uniformes */
                align-items: start;
            }
            /* Temas de Atuação (geralmente o 2º card) ocupa largura total para melhor leitura */
            #psi-tags-container > div:nth-child(2) {
                grid-column: 1 / -1;
            }
        }

        /* Botão de Favorito (Coração) */
        .btn-favorite {
            background: white;
            border: 1px solid #e5e7eb;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            color: #d1d5db; /* Cinza desativado */
            flex-shrink: 0;
        }
        .btn-favorite:hover { transform: scale(1.1); border-color: #fca5a5; }
        .btn-favorite.active {
            color: #ef4444; /* Vermelho */
            background-color: #fef2f2;
            border-color: #fecaca;
        }
        .btn-favorite svg { width: 24px; height: 24px; fill: currentColor; }

        /* --- Ajuste Global de Espaçamento: Redes Sociais e Badges --- */
        .social-links-profile { margin-bottom: 5px !important; }
        #psi-tags-display:empty { display: none !important; }
        
        /* Controle de Exibição do Badge de Horário */
        .badge-proximo-horario { 
            display: none; align-items: center; justify-content: center; gap: 8px; 
            background: #f0fdf4; color: #16a34a; font-weight: 700; 
        }
        .badge-proximo-horario.has-slot { display: flex !important; }
        
        /* Oculta texto longo (Bio) */
        .bio-collapsed { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
        
        /* --- BIO EXPANDÍVEL APP-LIKE --- */
        .bio-wrapper-modern { position: relative; display: flex; flex-direction: column; }
        .bio-fade-overlay {
            position: absolute;
            bottom: 45px; /* Altura do botão + espaço */
            left: 0; width: 100%; height: 60px;
            background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,1) 100%);
            pointer-events: none; opacity: 0; transition: opacity 0.3s ease;
        }
        .bio-wrapper-modern.is-collapsed .bio-fade-overlay { opacity: 1; }
        
        .btn-ler-mais-app {
            display: inline-flex; align-items: center; justify-content: center; gap: 6px;
            background: #e8f5e9; color: #1B4332; border: 1px solid #bbf7d0;
            border-radius: 50px; padding: 8px 20px; font-size: 0.95rem; font-weight: 700;
            cursor: pointer; margin: 10px auto 0 auto; transition: all 0.2s ease;
            width: fit-content; font-family: var(--fonte-corpo); box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .btn-ler-mais-app:hover {
            background: #dcfce7; transform: translateY(-2px);
        }
        .btn-ler-mais-app svg { width: 16px; height: 16px; transition: transform 0.3s ease; }
        .btn-ler-mais-app.expanded svg { transform: rotate(180deg); }

        /* NOVO: Estilo padrão para a linha do cabeçalho (Desktop) */
        .name-header-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        /* Estrelas Clicáveis */
        .hero-stars-container {
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .hero-stars-container:hover { opacity: 0.7; }

        /* Coluna Direita (Sticky) */
        .sticky-sidebar {
            position: -webkit-sticky !important;
            position: sticky !important;
            top: 120px !important;
            align-self: flex-start !important;
            z-index: 90;
            height: max-content;
        }

        .conversion-card-modern {
            background: white;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(27, 67, 50, 0.08);
            border: 1px solid rgba(27, 67, 50, 0.1);
            text-align: center;
            overflow: visible !important; /* CRÍTICO: Permite que o badge vazado apareça no mobile */
        }

        .price-display {
            font-family: var(--fonte-titulo);
            font-size: 2.5rem;
            color: #1B4332;
            margin: 10px 0;
            font-weight: 700 !important;
        }
        .price-display span {
            font-family: var(--fonte-corpo);
            font-size: 1rem;
            color: #666;
            font-weight: 400;
        }
        .price-suffix {
            font-size: 1rem; /* Aumentado para leitura */
            color: #666; /* Escurecido para contraste */
            display: block;
            line-height: 1;
        }

        .info-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #555;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }

        @media (max-width: 992px) {
            .profile-layout-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }
            .profile-header-flex {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }
            .profile-hero-card {
                padding: 25px 20px; /* Padding reduzido no mobile */
            }
            .profile-photo-wrapper {
                width: 120px; /* Foto um pouco menor */
                height: 120px;
            }
            .profile-name-block h1 {
                font-size: 1.8rem; /* Título ajustado */
            }
            .sticky-sidebar {
                position: static;
                order: -1; /* No mobile, o card de agendamento pode vir antes ou logo depois do hero */
            }
            
            /* --- CONVERSION CARD APP-LIKE (RODAPÉ MOBILE) --- */
            .conversion-card-modern {
                position: fixed;
                bottom: 0;
                width: calc(100vw / 0.88); /* CORREÇÃO: Compensa o zoom out do body */
                left: 50%;
                transform: translateX(-50%);
                box-sizing: border-box;
                border-radius: 24px 24px 0 0;
                z-index: 9999; /* Acima de tudo */
                padding: 16px 20px calc(16px + env(safe-area-inset-bottom)) 20px !important;
                display: flex;
                justify-content: space-between;
                align-items: center;
                text-align: left;
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(0,0,0,0.08); /* Borda em todos os lados */
                box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.15); /* Sombra mais forte */
                gap: 15px;
                overflow: visible !important; /* CRÍTICO: Permite que o badge de horário flutue acima da barra */
            }
            
            .conversion-card-modern .info-rows-container, 
            .conversion-card-modern .trust-badges-row {
                display: none !important; /* Oculta detalhes secundários */
            }

            .conversion-card-modern .price-section {
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .conversion-card-modern .price-title {
                display: block !important; /* Força exibir o título */
                font-size: 0.75rem !important;
                margin-bottom: 2px !important;
                color: #888 !important;
                font-weight: 700 !important;
                letter-spacing: 0.5px !important;
                text-transform: uppercase;
            }

            .conversion-card-modern .price-wrapper {
                display: flex;
                align-items: baseline;
                gap: 4px;
                flex-wrap: wrap;
            }

            .conversion-card-modern .price-display {
                font-size: clamp(1.3rem, 5vw, 1.65rem) !important;
                margin: 0 !important;
                text-align: left;
                line-height: 1;
                color: #1B4332 !important;
                font-weight: 800 !important;
                letter-spacing: -0.5px;
            }

            .conversion-card-modern .price-suffix {
                font-size: 0.8rem;
                color: #666; /* Escurecido para contraste */
                font-weight: 500;
                margin-top: 0;
            }

            /* Ajuste para o conteúdo não ficar escondido atrás do card fixo no mobile */
            body { padding-bottom: 120px; }
            /* Mostra o bloco de info mobile */
            .mobile-service-info { display: block !important; }
            
            /* Esconde badges de confiança no mobile para economizar espaço */
            .trust-badges-row { display: none !important; }
            
            /* Ajuste da animação no mobile (menos intensa) */
            @keyframes pulse-green-mobile {
                0% { box-shadow: 0 0 0 0 rgba(27, 67, 50, 0.4); }
                70% { box-shadow: 0 0 0 6px rgba(27, 67, 50, 0); }
                100% { box-shadow: 0 0 0 0 rgba(27, 67, 50, 0); }
            }
            .btn-pulse { animation-name: pulse-green-mobile !important; }

            /* --- NOVOS AJUSTES MOBILE (SOLICITADOS) --- */
            .verified-badge-mobile {
                display: flex !important;
                align-items: center;
                justify-content: center;
                gap: 6px;
                margin-bottom: 15px;
                color: #1B4332;
                font-size: 0.85rem;
                font-weight: 600;
                background-color: #e8f5e9;
                padding: 5px 15px;
                border-radius: 20px;
                width: fit-content;
                margin-left: auto;
                margin-right: auto;
            }
            
            /* Reorganização do Topo */
            .profile-name-block {
                display: flex;
                flex-direction: column;
                align-items: center;
                width: 100%;
            }
            
            /* Ajuste para centralizar Nome, CRP e Ícones */
            .name-header-row {
                display: flex;
                flex-direction: column;
                align-items: center;
                width: 100%;
            }

            /* Nome e CRP */
            .name-info-wrapper {
                display: flex;
                flex-direction: column; /* Hierarquia direta: Nome -> Especialidade -> Estrelas */
                align-items: center;
                text-align: center;
                margin-bottom: 10px;
            }
            
            /* Estrelas */
            #hero-rating-display {
                justify-content: center !important;
                margin-bottom: 15px !important;
            }

            /* Botões de Ação (Share/Fav) */
            .header-actions {
                justify-content: center;
                margin-bottom: 15px;
                width: 100%;
                display: flex;
                gap: 10px !important;
            }

            .header-actions .btn-favorite {
                width: 36px;
                height: 36px;
            }
            .header-actions .btn-favorite svg { width: 18px; height: 18px; }

            /* Esconde o texto de verificado do rodapé */
            .footer-verified-text { display: none !important; }
            
            /* Botão de Alta Conversão App-Like */
            #btn-agendar-whatsapp {
                flex-grow: 0 !important;
                width: 65% !important; /* Ocupa 65% no mobile para dar espaço ao preço */
                padding: 14px 24px !important;
                font-size: 1.05rem !important;
                border-radius: 50px !important;
                margin: 0;
                white-space: nowrap;
                background: var(--verde-escuro) !important;
                color: white !important;
                box-shadow: 0 8px 25px rgba(27, 67, 50, 0.3) !important;
                display: inline-flex !important;
                align-items: center !important;
                gap: 8px !important;
                font-weight: 700 !important;
                transition: transform 0.2s, box-shadow 0.2s;
            }

            #btn-agendar-whatsapp:active {
                transform: scale(0.95) !important;
                box-shadow: 0 4px 10px rgba(27, 67, 50, 0.2) !important;
            }

            /* Estado: Bloqueado (Trial Excedido) */
            #btn-agendar-whatsapp.bloqueado {
                background-color: #e0e0e0 !important;
                color: #888 !important;
                cursor: not-allowed !important;
                pointer-events: none !important;
                box-shadow: none !important;
            }

            /* Restaura o ícone do WhatsApp para passar confiança (App-like) */
            #btn-agendar-whatsapp svg { 
                display: block !important; 
                width: 20px !important; 
                height: 20px !important;
            }

            /* Remove a Bottom Nav desta página no mobile */
            .mobile-bottom-nav, .bottom-nav { display: none !important; }

            /* --- BOTTOM SHEETS: Transforma Modais em Gavetas no Mobile --- */
            .custom-modal-overlay {
                align-items: flex-end !important; /* Joga a caixa para o rodapé */
                padding: 0 !important;
            }
            .custom-modal-box {
                width: 100% !important;
                max-width: 100vw !important;
                border-radius: 24px 24px 0 0 !important; /* Arredonda apenas em cima */
                margin: 0 !important;
                padding: 35px 25px 40px 25px !important;
                animation: slideUpSheet 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
                position: relative;
            }
            /* "Alcinha" indicativa de gaveta do iOS */
            .custom-modal-box::before {
                content: '';
                position: absolute;
                top: 12px;
                left: 50%;
                transform: translateX(-50%);
                width: 40px;
                height: 5px;
                background: #e0e0e0;
                border-radius: 5px;
            }
            
            .badge-proximo-horario {
                position: absolute !important;
                top: -38px !important; /* Levanta a tag para flutuar acima da bottom nav */
                left: 50% !important;
                transform: translateX(-50%) !important;
                padding: 6px 18px !important;
                border-radius: 20px !important;
                border: 1px solid #bbf7d0 !important;
                box-shadow: 0 -4px 15px rgba(22, 163, 74, 0.15) !important;
                font-size: 0.8rem !important;
                white-space: nowrap !important;
                z-index: 100 !important;
            }
        }

        /* --- ANIMAÇÃO DE PULSO (CONVERSÃO) --- */
        @keyframes pulse-green {
            0% { box-shadow: 0 0 0 0 rgba(27, 67, 50, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(27, 67, 50, 0); }
            100% { box-shadow: 0 0 0 0 rgba(27, 67, 50, 0); }
        }
        .btn-pulse {
            animation: pulse-green 2s infinite;
        }

        /* --- ESTILOS MODERNOS PARA AVALIAÇÕES --- */
        .reviews-summary {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 25px;
            padding-bottom: 25px;
            border-bottom: 1px solid #f0f0f0;
        }
        .summary-avg-rating {
            font-family: var(--fonte-titulo);
            font-size: 2.8rem;
            color: #333;
            line-height: 1;
        }
        .summary-stars {
            color: #FFC107;
            font-size: 1.2rem;
        }
        .summary-count {
            color: #777;
            font-size: 0.9rem;
        }

        .review-card {
            padding: 20px 0;
            border-bottom: 1px solid #f0f0f0;
        }
        #reviews-list-container .review-card:last-of-type {
            border-bottom: none;
        }
        .review-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }
        .review-avatar {
            width: 48px; /* Levemente maior para apreciar os detalhes */
            height: 48px;
            border-radius: 50%;
            overflow: hidden; /* Garante que o SVG fique redondo */
            flex-shrink: 0;
            background-color: #f0f0f0; /* Fallback sutil */
        }
        .review-avatar svg { width: 100%; height: 100%; display: block; }
        
        .review-author-name { font-weight: 600; color: #333; }
        .review-date { font-size: 0.8rem; color: #666; display: block; }
        .review-rating { color: #FFC107; font-size: 0.9rem; margin-bottom: 10px; }
        .review-comment { color: #555; font-size: 0.95rem; line-height: 1.6; margin: 0; }

        .btn-show-more {
            display: block;
            width: fit-content;
            margin: 30px auto 0 auto;
            padding: 10px 25px;
            border: 1px solid #ccc;
            background: #fff;
            color: #333;
            font-weight: 600;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-show-more:hover { background: #f5f5f5; border-color: #999; }

        /* Badges de Confiança (Desktop) */
        .trust-badges-row {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid #f0f0f0;
        }
        .trust-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.8rem;
            color: #666;
            font-weight: 500;
        }
        .trust-item svg {
            width: 16px;
            height: 16px;
            color: var(--verde-escuro);
        }

        /* --- SKELETON LOADER (Animação de Carregamento App-like) --- */
        .skeleton-pulse {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: skeleton-shimmer 1.5s infinite linear;
            border-radius: 8px;
        }
        @keyframes skeleton-shimmer {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        @keyframes slideUpSheet {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }
        
        /* --- SEGMENTED CONTROLS (Abas App-like) --- */
        @media (max-width: 992px) {
            .tabs-nav-app {
                display: flex;
                background: rgba(248, 249, 250, 0.95);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border-radius: 50px;
                padding: 6px;
                margin-top: 10px;
                margin-bottom: 35px;
                border: 1px solid #e9ecef;
                position: -webkit-sticky;
                position: sticky;
                top: 80px; /* Fica logo abaixo do header */
                z-index: 90;
                box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            }
            .tabs-nav-app .tab-link {
                flex: 1;
                background: transparent;
                border: none;
                border-radius: 50px;
                font-size: 1rem;
                font-weight: 600;
                font-family: var(--fonte-corpo);
                padding: 14px 15px;
                color: #4b5563;;
                cursor: pointer;
                transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
                margin: 0;
            }
            .tabs-nav-app .tab-link:hover {
                color: #1B4332;
            }
            .tabs-nav-app .tab-link.active {
                background: #1B4332;
                color: #ffffff;
                box-shadow: 0 4px 15px rgba(27, 67, 50, 0.2);
                transform: scale(1.02);
            }
            .tab-content { display: none; animation: fadeInTab 0.3s ease; }
            .tab-content.active { display: block; }
            .desktop-section-title { display: none !important; }
        }
        @media (min-width: 993px) {
            /* Comportamento Clássico no Desktop */
            .tabs-nav-app { display: none !important; }
            .tab-content { display: block !important; margin-bottom: 0px !important; } /* Zera gap inferior */
            .desktop-section-title {
                font-family: var(--fonte-titulo);
                color: #1B4332;
                font-size: 1.5rem;
                border-bottom: 1px solid #eee;
                padding-bottom: 12px;
                margin-bottom: 20px;
                margin-top: 10px;
                display: block;
            }
            .badge-proximo-horario {
                width: 100% !important;
                box-sizing: border-box !important;
                padding: 12px !important;
                border-radius: 12px !important;
                border: 1px dashed #bbf7d0 !important;
                margin-bottom: 15px !important;
                font-size: 0.95rem !important;
            }
        }
        @keyframes fadeInTab { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

        /* Foco na textarea moderna de avaliação */
        .review-form-box textarea:focus {
            background-color: #fff !important;
            border-color: var(--verde-escuro) !important;
            box-shadow: 0 0 0 3px rgba(27, 67, 50, 0.1) !important;
            outline: none !important;
        }

        @media (max-width: 768px) {
            /* Remove bordas do card principal no mobile para fundir com o fundo (Estilo Nativo iOS/Android) */
            .profile-hero-card { border: none !important; box-shadow: none !important; padding: 10px 0 !important; background: transparent !important; }
            .mobile-service-info { border: none !important; box-shadow: none !important; background: transparent !important; border-top: 1px solid #eee !important; border-radius: 0 !important; padding: 20px 0 !important; }

            /* --- AJUSTES MOBILE: Formulário de Avaliação App-like --- */
            .review-form-box { padding: 25px 20px !important; border-radius: 20px !important; }
            .review-form-box > div:first-child h4 { font-size: 1.2rem !important; }
            .review-form-box > div:first-child p { font-size: 0.85rem !important; }
            
            #form-nova-avaliacao > div:first-child { padding: 20px 15px !important; gap: 8px !important; }
            #form-nova-avaliacao > div:first-child label { font-size: 1rem !important; }
            .star-rating-input label { font-size: 2.2rem !important; } /* Reduz a estrela para caber sem espremer */
            #form-nova-avaliacao .btn-principal { width: 100% !important; padding: 15px !important; font-size: 1rem !important; border-radius: 50px !important; }
        }
    </style>
</head>
<body>

