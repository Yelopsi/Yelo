<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- SEO INJETADO NO SERVIDOR -->
    <title><%= psicologo.nome %> | Psicólogo(a) em <%= psicologo.cidade || 'Todo Brasil' %></title>
    <% 
      const bioSnippet = psicologo.bio 
        ? psicologo.bio.replace(/<[^>]*>?/gm, '').substring(0, 155) + '...' 
        : `Encontre acolhimento e suporte com ${psicologo.nome}. Psicólogo(a) especialista em saúde mental.`;
    %>
    <meta name="description" content="<%= bioSnippet %>">
    
    <!-- Links para seus arquivos CSS -->
    <!-- CORREÇÃO: Ordem e arquivos corretos para garantir que todos os estilos sejam aplicados -->
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="//css/05-pages.css">
    <link rel="stylesheet" href="/css/psi_dashboard.css">

    <!-- FIX CSS: Garante o funcionamento do 'position: sticky' da sidebar -->
    <style>
        body, html { overflow-x: clip !important; }
        .profile-page-main, .container, .profile-layout-grid {
            overflow: visible !important;
        }

        .profile-layout-grid {
            align-items: flex-start !important; /* CRÍTICO PARA O STICKY FUNCIONAR */
        
        }
      .sticky-sidebar {
            position: -webkit-sticky !important;
            position: sticky !important;
            top: 100px !important; /* Distância do topo ao rolar */
            align-self: flex-start !important;
            height: max-content !important;
            z-index: 90;
        }
    </style>

</head>
<body>
    <!-- Inclua seu header/menu principal aqui, se for um parcial -->
    <%- include('partials/header') %>

    <main class="profile-page-main">
        <div id="profile-container" class="container">
            <!-- ESTRUTURA CORRIGIDA: Usando as classes CSS corretas -->
            <div class="profile-layout-grid">
                
                <!-- Coluna Principal (Esquerda) -->
                <div class="profile-main-content">

                </div>
                <!-- Card de Herói com informações principais -->
                    <div class="profile-hero-card widget">
                        <div class="profile-photo-wrapper">
                            <img id="psi-foto" src="<%= psicologo.fotoUrl || '/assets/images/placeholder-avatar.png' %>" alt="Foto de <%= psicologo.nome %>" class="profile-avatar-lg">
                        </div>
                        <h1 id="psi-nome"><%= psicologo.nome %></h1>
                        <span id="psi-crp" class="crp">CRP: <%= psicologo.crp %></span>
                        
                        <!-- Container para estrelas e redes sociais -->
                        <div id="hero-rating-display" class="rating-display-hero">
                            <!-- JS vai popular as estrelas aqui -->
                        </div>

                        <div class="social-share-row">
                            <div id="psi-social-links" class="social-links-group">
                                <!-- JS vai popular os ícones sociais aqui -->
                            </div>
                            <button id="btn-favorite" class="icon-btn-modern" title="Adicionar aos Favoritos">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                            </button>
                        </div>
                    </div>

                    <!-- Abas de Conteúdo -->
                    <div class="profile-body-tabs widget">
                        <nav class="tabs-nav">
                            <button class="tab-link active" data-tab="sobre">Sobre Mim</button>
                            <button class="tab-link" data-tab="avaliacoes">Avaliações</button>
                            <button class="tab-link" data-tab="detalhes">Detalhes</button>
                        </nav>
                        <div id="tab-sobre" class="tab-content active">
                        <h3 class="titulo-bio">Biografia</h3>
                            <div id="bio-content-wrapper" class="is-collapsed">
                                <p id="psi-bio-text" class="bio-text bio-collapsed"><%- psicologo.bio || 'Biografia ainda não preenchida.' %></p>
                                <div id="bio-fade-overlay"></div>
                            </div>
                            <button id="btn-ler-mais-bio" class="btn-link-expand" style="display: none;">
                                <span class="btn-text">Ler mais</span>
                            </button>
                            
                            <div id="psi-formacao-container" style="margin-top: 20px;">
                                <% if (psicologo.formacao_nivel || psicologo.formacao_desc) { %>
                                    <h3 class="titulo-bio">Formação</h3>
                                    <strong id="psi-formacao-nivel"><%= psicologo.formacao_nivel %></strong>
                                    <p id="psi-formacao-desc"><%- psicologo.formacao_desc %></p>
                                <% } %>
                            </div>
                        </div>

                        <div id="tab-detalhes" class="tab-content">
                            <!-- JS vai popular as tags de especialidades aqui -->
                            <div id="psi-tags-container"></div>
                        </div>
                            
                        <!-- ESTRUTURA DA ABA DE AVALIAÇÕES (para o JS popular) -->
                        <div id="tab-avaliacoes" class="tab-content">
                            <div id="reviews-summary-container">
                                <!-- O sumário de estrelas será injetado aqui pelo JS -->
                            </div>
                            <div id="reviews-list-container">
                                <!-- A lista de avaliações será injetada aqui pelo JS -->
                            </div>
                            <div id="load-more-container" style="text-align: center; margin-top: 20px; display: none;">
                                <button id="btn-show-more" class="btn btn-secundario">Mostrar mais</button>
                            </div>

                            <!-- Formulário para Nova Avaliação (controlado pelo JS) -->
                            <div id="login-wall-box" class="login-wall-box" style="display: none; margin-top: 40px;">
                                <h4>Deixe sua avaliação</h4>
                                <p>Para avaliar, você precisa estar logado. Isso garante a autenticidade dos depoimentos.</p>
                                <div class="login-wall-actions">
                                    <a href="/login?redirect=<%= psicologo.slug %>" class="btn btn-principal" rel="nofollow">Fazer Login para Avaliar</a>
                                </div>
                            </div>

                            <form id="form-nova-avaliacao" class="review-form-box" style="display: none; margin-top: 40px;">
                                <h4>Deixe sua avaliação</h4>
                                <div class="form-group">
                                    <div class="star-rating-input" id="rating-input-stars">
                                        <!-- Estrelas serão geradas aqui ou podem ser HTML estático -->
                                    </div>
                                </div>
                                <textarea name="comentario" class="form-control" rows="4" placeholder="Conte como foi sua experiência..."></textarea>
                                <button type="submit" class="btn btn-principal" style="margin-top: 15px;">Enviar Avaliação</button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Coluna Lateral (Direita) -->
                <div class="sticky-sidebar">
                    <div class="conversion-card-modern widget">
                        <% if (psicologo.valor_sessao_numero) { %>
                            <div class="price-display" id="psi-valor">R$ <%= psicologo.valor_sessao_numero.toFixed(2).replace('.', ',') %></div>
                            <span class="price-suffix">/ sessão de 50 min</span>
                        <% } else { %>
                            <div class="price-display" id="psi-valor">Sob Consulta</div>
                        <% } %>
                        
                        <a href="#" id="btn-agendar-whatsapp" class="btn btn-principal btn-pulse">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                            Agendar via WhatsApp
                        </a>

                        <% if (psicologo.cidade && psicologo.estado) { %>
                            <div id="psi-localizacao-container" class="location-display">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                <span id="psi-cidade-estado"><%= psicologo.cidade %> - <%= psicologo.estado %></span>
                            </div>
                        <% } %>

                        <div class="trust-badges-row">
                            <div class="trust-item"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg><span>Pagto. Seguro</span></div>
                            <div class="trust-item"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg><span>Sigilo Garantido</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- INJEÇÃO DE DADOS PARA O CLIENT-SIDE SCRIPT -->
    <script>
        window.YELO_PROFILE_DATA = <%- JSON.stringify(psicologo) %>;
    </script>

    <!-- Seus scripts JS que operam no HTML pré-renderizado -->
    <script src="/js/perfil_publico.js"></script>
</body>
</html>