    <!-- Biblioteca de Confetes para o Efeito UAU -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>

    <script>
        // Função para mostrar o Toast Animado e disparar confetes
        function dispararEfeitoUau() {
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 100,
                    spread: 70,
                    origin: { y: 0.6 },
                    colors: ['#1B4332', '#FFEE8C', '#4ade80', '#ffffff']
                });
            }

            let container = document.getElementById('toast-container');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toast-container';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = `toast toast-success`;
            toast.innerHTML = `<span style="font-size:1.2rem">✨</span> <span>Link copiado com sucesso!</span>`;
            
            container.appendChild(toast);
            
            requestAnimationFrame(() => {
                toast.style.display = 'flex';
                toast.style.opacity = '1';
                toast.style.transform = 'translateY(0) scale(1)';
            });
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-20px) scale(0.9)';
                setTimeout(() => toast.remove(), 400);
            }, 3500);
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Lógica para o botão de compartilhar (Delegação de eventos para funcionar após renderização do JS)
            document.addEventListener('click', async (e) => {
                const btnShare = e.target.closest('#btn-share');
                if (btnShare) {
                    e.preventDefault();
                    
                    // Captura o nome do profissional para personalizar a mensagem
                    const nomePsi = document.getElementById('psi-nome') ? document.getElementById('psi-nome').textContent.trim() : 'este profissional';
                    const shareText = `✨ Conheça ${nomePsi} na Yelo!\n\nVeja o perfil completo, avaliações e horários disponíveis acessando o link abaixo:`;

                    // API Nativa de Compartilhamento do Dispositivo (iOS / Android / Safari Mac)
                    if (navigator.share) {
                        try {
                            await navigator.share({
                                title: `Perfil de ${nomePsi} na Yelo`,
                                text: shareText,
                                url: window.location.href
                            });
                        } catch (err) { console.log('Erro ao compartilhar:', err); }
                    } else if (navigator.clipboard && window.isSecureContext) {
                        // Fallback: Desktop sem suporte nativo
                        const fullText = `${shareText}\n👉 ${window.location.href}`;
                        navigator.clipboard.writeText(fullText).then(() => {
                            dispararEfeitoUau();
                        }).catch(err => console.log('Erro na área de transferência:', err));
                    } else {
                        const fullText = `${shareText}\n👉 ${window.location.href}`;
                        const input = document.createElement('textarea');
                        input.value = fullText;
                        document.body.appendChild(input);
                        input.select();
                        document.execCommand('copy');
                        document.body.removeChild(input);
                        dispararEfeitoUau();
                    }
                }
            });

            // Lógica para clicar nas estrelas e descer para avaliações
            const ratingDisplay = document.getElementById('hero-rating-display');
            if (ratingDisplay) {
                ratingDisplay.addEventListener('click', () => {
                    const reviewsSection = document.getElementById('tab-avaliacoes');
                    if(reviewsSection) reviewsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
            }

            // Hook para renderizar badges quando os dados chegarem (assumindo que perfil_psicologo.js preenche os dados)
            // Vamos observar mudanças ou esperar que o script principal chame renderBadges
            // Se você estiver usando fetch no perfil_psicologo.js, adicione:
            // if (data.badges) renderBadges(data.badges);
            // Como não tenho acesso ao perfil_psicologo.js aqui, deixo a função global disponível.

            // --- NOVO: LÓGICA DE AUTO-RESIZE PARA TEXTAREA DE AVALIAÇÃO ---
            const reviewTextarea = document.querySelector('#form-nova-avaliacao textarea');
            if (reviewTextarea) {
                const autoResize = () => {
                    reviewTextarea.style.height = 'auto';
                    reviewTextarea.style.height = reviewTextarea.scrollHeight + 'px';
                };
                reviewTextarea.addEventListener('input', autoResize);
            }

            // --- PLG: Interceptador para Bloquear WhatsApp se o limite do Trial for atingido ---
            const originalPublicFetch = window.fetch;
            window.fetch = async function(...args) {
                const response = await originalPublicFetch.apply(this, args);
                try {
                    const url = args[0] instanceof Request ? args[0].url : args[0];
                    // Fica escutando quando a API envia os dados do psicólogo para popular a página
                    if (url.includes('/api/public/psychologists/') && !url.includes('whatsapp-click') && !url.includes('appearance')) {
                        response.clone().json().then(data => {
                            if (data && data.id) {
                                const MAX_TRIAL_CLICKS = 3;
                                const isAssinante = data.status === 'active' || data.is_exempt;
                                const btnWhatsApp = document.getElementById('btn-agendar-whatsapp');

                                if (btnWhatsApp && !isAssinante && (data.whatsapp_clicks || 0) >= MAX_TRIAL_CLICKS) {
                                    btnWhatsApp.classList.add('bloqueado');
                                    btnWhatsApp.innerHTML = '🚫 Agenda Lotada no Momento';
                                    btnWhatsApp.href = '#'; // Remove o link real
                                    btnWhatsApp.onclick = (e) => e.preventDefault(); // Impede evento de rastreio de clique
                                }
                            }
                        }).catch(e => console.warn(e));
                    }
                } catch (e) {}
                return response;
            };
        });
    </script>
