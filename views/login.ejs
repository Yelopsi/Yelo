<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Entrar - Yelo | Sua Saúde Mental em Dia</title>
    <meta name="description" content="Acesse sua conta na Yelo para gerenciar sessões, falar com seu psicólogo ou atualizar seu perfil com segurança.">
    
    <meta property="og:title" content="Entrar na Yelo">
    <meta property="og:description" content="Acesse sua área exclusiva de pacientes ou psicólogos.">

    <link rel="canonical" href="https://www.yelopsi.com.br/login" />

    <%- include('partials/head') %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&family=Mulish:wght@400;500;600&display=swap" rel="stylesheet">
    <script nonce="<%= nonce %>" src="https://accounts.google.com/gsi/client" async defer></script>
    <style>
        :root {
            --fonte-titulo: 'Lora', serif;
            --fonte-corpo: 'Mulish', sans-serif;
        }
        html, body {
            overflow: hidden !important; /* Bloqueia qualquer barra de rolagem global nas páginas de autenticação */
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: var(--fonte-corpo), sans-serif;
            background-color: #f9fafb;
            display: flex;
            align-items: center; /* Centraliza verticalmente e horizontalmente */
            justify-content: center;
            position: relative;
        }
        
        /* App-Like Auth Box */
        .app-auth-box {
            background: #ffffff;
            width: 100%;
            max-width: 420px;
            max-height: 100vh; /* Impede que o quadro passe da tela */
            overflow-y: auto; /* Rolagem apenas interna no celular, caso precise */
            padding: 30px 24px;
            display: flex;
            flex-direction: column;
            box-sizing: border-box;
            position: relative;
            z-index: 2;
            scrollbar-width: none; /* Oculta a barra no Firefox */
            -ms-overflow-style: none; /* Oculta a barra no IE/Edge */
        }
        .app-auth-box::-webkit-scrollbar {
            display: none; /* Oculta a barra no Chrome, Safari e Opera */
        }
        @media(min-width: 480px) {
            .app-auth-box {
                max-height: 90vh; /* Dá um respiro elegante em cima e embaixo no desktop */
                border-radius: 24px;
                box-shadow: 0 10px 40px rgba(0,0,0,0.06);
                padding: 40px 32px;
            }
        }
        
        .app-top-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
        .app-back-btn { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: #f3f4f6; color: #333; text-decoration: none; transition: 0.2s; }
        .app-back-btn:hover { background: #e5e7eb; }
        .app-logo { height: 28px; }
        
        .app-title { font-family: var(--fonte-titulo, serif); font-size: 1.8rem; color: #1B4332; margin: 0 0 8px 0; line-height: 1.2; font-weight: 700; }
        .app-subtitle { color: #666; margin: 0 0 20px 0; font-size: 0.95rem; }
        
        .app-input-group { margin-bottom: 16px; position: relative; }
        .app-input-group label { display: block; font-size: 0.8rem; font-weight: 700; color: #4b5563; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
        .app-input { width: 100%; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px; font-size: 16px; color: #111; transition: all 0.3s ease; box-sizing: border-box; font-family: inherit; }
        .app-input:focus { background: #fff; border-color: #1B4332; box-shadow: 0 0 0 4px rgba(27, 67, 50, 0.1); outline: none; }
        
        .app-input-password-wrapper { position: relative; display: flex; align-items: center; }
        .app-input-password-wrapper input { padding-right: 50px; }
        .password-toggle-icon { position: absolute; right: 16px; top: 50% !important; bottom: auto !important; transform: translateY(-50%) !important; width: auto !important; height: auto !important; z-index: 10 !important; color: #9ca3af; cursor: pointer; display: flex; padding: 4px; transition: color 0.2s; }
        .password-toggle-icon:hover { color: #1B4332; }
        
        .app-btn-primary { width: 100%; background: #1B4332; color: white; border: none; border-radius: 50px; padding: 14px; font-size: 1rem; font-weight: 700; cursor: pointer; transition: all 0.3s; margin-top: 5px; display: flex; justify-content: center; align-items: center; gap: 8px; }
        .app-btn-primary:hover { background: #143d2e; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(27, 67, 50, 0.25); }
        .app-btn-primary:disabled { opacity: 0.7; cursor: not-allowed; transform: none; box-shadow: none; }
        
        .app-divider { display: flex; align-items: center; text-align: center; margin: 20px 0; color: #9ca3af; font-size: 0.85rem; font-weight: 600; }
        .app-divider::before, .app-divider::after { content: ''; flex: 1; border-bottom: 1px solid #e5e7eb; }
        .app-divider span { padding: 0 15px; }
        
        .app-footer-link { text-align: center; margin-top: 20px; font-size: 0.9rem; color: #6b7280; }
        .app-footer-link a { color: #1B4332; font-weight: 700; text-decoration: none; }
        
        .g_id_signin { display: flex; justify-content: center; width: 100%; }
        .doodle-bg { position: absolute; opacity: 0.4; pointer-events: none; z-index: 0; color: #e0e0e0; }
        .doodle-bg.top-left { top: -50px; left: -50px; width: 300px; transform: rotate(45deg); }
        .doodle-bg.bottom-right { bottom: -50px; right: -50px; width: 250px; transform: rotate(-45deg); }
        .hidden { display: none !important; }
        .spin-anim { animation: spin 1s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
        <svg class="doodle-bg top-left" viewBox="0 0 200 200" fill="currentColor"><path d="M45.7,-76.3C58.9,-69.3,69.1,-55.6,76.3,-41.2C83.5,-26.8,87.7,-11.7,85.6,2.6C83.5,16.9,75.1,30.4,65.6,42.2C56.1,54,45.5,64.1,33.3,70.3C21.1,76.5,7.3,78.8,-5.3,76.9C-17.9,75,-34.7,68.9,-48.6,59.6C-62.5,50.3,-73.5,37.8,-79.6,23.3C-85.7,8.8,-86.9,-7.7,-80.7,-21.8C-74.5,-35.9,-60.9,-47.6,-46.8,-54.3C-32.7,-61,-18.1,-62.7,-2.9,-62.2C12.3,-61.7,24.6,-59,32.5,-83.3L45.7,-76.3Z" transform="translate(100 100)" /></svg>
        <svg class="doodle-bg bottom-right" viewBox="0 0 200 200" fill="currentColor"><path d="M38.1,-63.8C49.3,-54.6,58.3,-43.3,65.5,-30.8C72.7,-18.3,78.1,-4.6,76.3,8.3C74.5,21.2,65.5,33.3,55.3,43.4C45.1,53.5,33.7,61.6,21.1,66.1C8.5,70.6,-5.3,71.5,-18.4,67.8C-31.5,64.1,-43.9,55.8,-53.4,45.2C-62.9,34.6,-69.5,21.7,-70.8,8.2C-72.1,-5.3,-68.1,-19.4,-59.6,-31.1C-51.1,-42.8,-38.1,-52.1,-25.3,-60.1C-12.5,-68.1,0.1,-74.8,12.7,-74.8C25.3,-74.8,38.1,-68.1,38.1,-63.8Z" transform="translate(100 100)" /></svg>

        <div class="app-auth-box">
            <div class="app-top-bar">
                <a href="/" class="app-back-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                </a>
                <img src="/assets/logos/logo-escura.png" alt="Yelo" class="app-logo">
                <div style="width: 40px;"></div> <!-- Espaçador para simetria -->
            </div>

            <h1 class="app-title">Bem-vindo/a de volta</h1>
            <p class="app-subtitle">Acesse sua conta para continuar.</p>

            <form id="form-login">
                <div class="app-input-group">
                    <label for="email">E-mail</label>
                    <input type="email" id="email-login" class="app-input" name="email" autocomplete="username" placeholder="seu@email.com" required>
                </div>
                <div class="app-input-group">
                    <label for="senha-login">Senha</label>
                    <div class="app-input-password-wrapper">
                        <input type="password" id="senha-login" class="app-input" name="senha-login" autocomplete="current-password" placeholder="Sua senha secreta" required>
                        <span class="password-toggle-icon" id="toggleSenhaLogin">
                            <svg class="eye-closed hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                            </svg>
                            <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.477 0 8.268 2.943 9.542 7-1.274 4.057-5.065 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </span>
                    </div>
                </div>
                <button type="submit" class="app-btn-primary">Entrar</button>
            </form>

            <div class="app-divider"><span>OU ACESSE COM</span></div>

            <!-- Botão do Google -->
            <div id="g_id_onload"
                 data-client_id="283886540808-qj13i35cfagnp9rc6qou1o66mdv3ppkl.apps.googleusercontent.com"
                 data-callback="handleCredentialResponse"
                 data-auto_prompt="false">
            </div>
            <div class="g_id_signin"
                 data-type="standard"
                 data-size="large"
                 data-theme="outline"
                 data-text="sign_in_with"
                 data-shape="pill"
                 data-logo_alignment="left">
            </div>

            <div class="app-footer-link">
                <a href="/recuperar-senha" style="display: block; margin-bottom: 15px; color: #6b7280; font-weight: 500;">Esqueceu sua senha?</a>
                Não tem uma conta? <a href="/cadastro">Cadastre-se</a>
            </div>
        </div>

    <script nonce="<%= nonce %>" src="/js/login.js?v=1.7"></script>
    <script nonce="<%= nonce %>">
      // Função reutilizável para alternar a senha
      function setupPasswordToggle(toggleId, inputId) {
        const toggle = document.getElementById(toggleId);
        const input = document.getElementById(inputId);

        if (toggle && input) {
            const eyeClosed = toggle.querySelector('.eye-closed');
            const eyeOpen = toggle.querySelector('.eye-open');

            toggle.addEventListener("click", () => {
                const isPassword = input.type === "password";
                input.type = isPassword ? "text" : "password";
                if (isPassword) {
                    eyeClosed.classList.remove('hidden');
                    eyeOpen.classList.add('hidden');
                } else {
                    eyeClosed.classList.add('hidden');
                    eyeOpen.classList.remove('hidden');
                }
            });
        }
      }
      setupPasswordToggle("toggleSenhaLogin", "senha-login");
    </script>
    <script nonce="<%= nonce %>">
        // Callback do Google
        async function handleCredentialResponse(response) {
            try {
                const globalUtms = JSON.parse(localStorage.getItem('yelo_global_utms') || '{}');
                const globalFirstUtms = JSON.parse(localStorage.getItem('yelo_global_first_utms') || '{}');

                const payload = {
                    token: response.credential,
                    utm_source: globalUtms.utm_source || null,
                    utm_medium: globalUtms.utm_medium || null,
                    utm_campaign: globalUtms.utm_campaign || null,
                    utm_content: globalUtms.utm_content || null,
                    first_utm_source: globalFirstUtms.utm_source || null,
                    first_utm_medium: globalFirstUtms.utm_medium || null,
                    first_utm_campaign: globalFirstUtms.utm_campaign || null,
                    first_utm_content: globalFirstUtms.utm_content || null
                };

                const res = await fetch('/api/auth/google', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();

                if (res.ok) {
                    localStorage.setItem('Yelo_token', data.token);
                    localStorage.setItem('Yelo_user', JSON.stringify(data.user));
                    if (window.showToast) window.showToast('Entrando...', 'success');
                    setTimeout(() => { window.location.href = data.redirect; }, 600);
                } else {
                    if (window.showToast) window.showToast(data.error || 'Erro ao entrar com Google.', 'error');
                    else alert(data.error || 'Erro ao entrar com Google.');
                }
            } catch (error) {
                console.error('Erro Google Login:', error);
                if (window.showToast) window.showToast('Erro de conexão ao tentar login com Google.', 'error');
                else alert('Erro de conexão ao tentar login com Google.');
            }
        }
    </script>
    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            // 1. Tenta ler os parâmetros da URL
            const urlParams = new URLSearchParams(window.location.search);
            const emailAuto = urlParams.get('email');

            // 2. Se houver um e-mail na URL, preenche o campo
            if (emailAuto) {
                const inputEmail = document.querySelector('input[name="email"]');
                if (inputEmail) {
                    inputEmail.value = emailAuto;
                    // Opcional: Foca automaticamente no campo de senha para agilizar
                    const inputSenha = document.getElementById('senha-login');
                    if (inputSenha) inputSenha.focus();
                }
            }
        });
    </script>
</body>
</html>