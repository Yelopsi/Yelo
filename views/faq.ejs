<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Perguntas Frequentes - Yelo</title>
    <link rel="canonical" href="https://www.yelopsi.com.br/faq" />
    <%- include('partials/head') %>
    <style>
        /* Doodles de Fundo */
        /* Links Mobile Topo */
        .mobile-top-links {
            display: none;
        }
        @media (max-width: 768px) {
            .mobile-top-links {
                display: flex;
                justify-content: center;
                gap: 20px;
                margin-bottom: 20px;
            }
            .mobile-top-links a {
                color: var(--branco-puro, #fff);
                text-decoration: none;
                font-weight: 500;
                opacity: 0.9;
            }
        }

        .doodle-bg {
            position: absolute;
            opacity: 0.4;
            pointer-events: none;
            z-index: 0;
            color: #e0e0e0;
        }
        .doodle-bg.top-left { top: 50px; left: -50px; width: 300px; transform: rotate(45deg); }
        .doodle-bg.bottom-right { bottom: 50px; right: -50px; width: 250px; transform: rotate(-45deg); }
        
        /* Acordeão Orgânico */
        .acordeao-item {
            border: 1px solid rgba(0,0,0,0.03) !important;
            margin-bottom: 15px;
            background-color: #F8F3ED; /* Creme default */
            border-radius: 24px 60px 24px 60px !important;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
            cursor: pointer;
        }
        .acordeao-item:nth-child(2n) {
            background-color: #E6F4F1; /* Verde suave */
            border-radius: 60px 24px 60px 24px !important;
        }
        .acordeao-item:nth-child(3n) {
            background-color: #FFF8E1; /* Amarelo suave */
            border-radius: 24px 60px 24px 60px !important;
        }
        .acordeao-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }
        
        .acordeao-titulo {
            background: transparent !important;
            font-family: var(--font-titulos);
            color: var(--verde-escuro);
            font-weight: 600;
            padding: 20px 30px !important;
            width: 100%;
            text-align: left;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: none;
            cursor: pointer;
        }

        .acordeao-titulo::after {
            content: '+';
            font-size: 1.5rem;
            font-weight: 400;
            transition: transform 0.3s ease;
        }

        .acordeao-titulo.ativo::after {
            transform: rotate(45deg);
        }
        
        .acordeao-conteudo {
            display: grid;
            grid-template-rows: 0fr;
            transition: grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: auto;
            overflow: hidden;
        }
        .acordeao-conteudo p {
            min-height: 0;
            padding: 0 30px 30px 30px !important;
            color: #555;
            margin: 0;
            line-height: 1.6;
        }
        .acordeao-item.ativo .acordeao-conteudo {
            grid-template-rows: 1fr;
        }

        /* FAQ CTA Card */
        .faq-cta {
            background-color: #ffffff !important;
            border: 1px solid rgba(0,0,0,0.05);
            border-radius: 60px 24px 60px 24px !important;
            box-shadow: 0 15px 40px rgba(0,0,0,0.05) !important;
            position: relative;
            overflow: hidden;
        }
    </style>
</head>
<body class="pagina-com-conteudo-atras">

    <%- include('partials/header') %>

    <main>
        <section class="faq-hero ruido">
            <div class="container-sobre">
                <!-- Links Mobile Topo -->
                <div class="mobile-top-links">
                    <a href="/sobre">Sobre</a>
                    <a href="/faq">FAQ</a>
                    <a href="/blog">Blog</a>
                </div>
                <h1>Perguntas Frequentes</h1>
                <p class="subtitulo-secao">Encontre aqui as respostas para as suas principais dúvidas sobre a Yelo.</p>
                <div class="faq-busca-container">
                    <input type="search" id="faq-busca" placeholder="Digite uma palavra-chave (ex: preço, cadastro, terapia)...">
                </div>
            </div>

            <div class="faq-wave-bottom">
                <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
                    <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" class="shape-fill"></path>
                </svg>
            </div>
        </section>

        <section class="secao-conteudo-pagina" style="padding-top: 60px; position: relative; overflow: hidden;">
            <svg class="doodle-bg top-left" viewBox="0 0 200 200" fill="currentColor"><path d="M45.7,-76.3C58.9,-69.3,69.1,-55.6,76.3,-41.2C83.5,-26.8,87.7,-11.7,85.6,2.6C83.5,16.9,75.1,30.4,65.6,42.2C56.1,54,45.5,64.1,33.3,70.3C21.1,76.5,7.3,78.8,-5.3,76.9C-17.9,75,-34.7,68.9,-48.6,59.6C-62.5,50.3,-73.5,37.8,-79.6,23.3C-85.7,8.8,-86.9,-7.7,-80.7,-21.8C-74.5,-35.9,-60.9,-47.6,-46.8,-54.3C-32.7,-61,-18.1,-62.7,-2.9,-62.2C12.3,-61.7,24.6,-59,32.5,-83.3L45.7,-76.3Z" transform="translate(100 100)" /></svg>
            <svg class="doodle-bg bottom-right" viewBox="0 0 200 200" fill="currentColor"><path d="M38.1,-63.8C49.3,-54.6,58.3,-43.3,65.5,-30.8C72.7,-18.3,78.1,-4.6,76.3,8.3C74.5,21.2,65.5,33.3,55.3,43.4C45.1,53.5,33.7,61.6,21.1,66.1C8.5,70.6,-5.3,71.5,-18.4,67.8C-31.5,64.1,-43.9,55.8,-53.4,45.2C-62.9,34.6,-69.5,21.7,-70.8,8.2C-72.1,-5.3,-68.1,-19.4,-59.6,-31.1C-51.1,-42.8,-38.1,-52.1,-25.3,-60.1C-12.5,-68.1,0.1,-74.8,12.7,-74.8C25.3,-74.8,38.1,-68.1,38.1,-63.8Z" transform="translate(100 100)" /></svg>

            <div class="container-sobre" style="position: relative; z-index: 2;">
                
                <div class="faq-categoria">
                    <h2 class="titulo-secao-menor">Para Pacientes (Para quem busca terapia)</h2>
                    <div class="acordeao-container">
                        <div class="acordeao-item"><button class="acordeao-titulo">O que é a Yelo?</button><div class="acordeao-conteudo"><p>A Yelo é uma plataforma de conexão qualificada entre pacientes e psicólogos. Através de um questionário simples, conectamos você a profissionais que se alinham com suas necessidades, valores e preferências.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">Quanto custa usar a Yelo para encontrar um profissional?</button><div class="acordeao-conteudo"><p>Para pacientes, o uso da plataforma é 100% gratuito. Nossa missão é democratizar o acesso à psicoterapia, e isso começa por facilitar a sua busca sem nenhum custo.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">Preciso me cadastrar para usar a plataforma?</button><div class="acordeao-conteudo"><p>Não para encontrar um profissional. Você pode preencher o questionário e receber suas recomendações de forma anônima. O cadastro só é necessário se você quiser salvar perfis ou deixar uma avaliação.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">A Yelo oferece atendimento de emergência?</button><div class="acordeao-conteudo"><p>Não. A Yelo é uma plataforma para conectar você a profissionais para sessões agendadas. Se você estiver em uma crise, por favor, ligue para o CVV (Centro de Valorização da Vida) no número 188 ou procure o hospital mais próximo.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">Por que preciso preencher um questionário?</button><div class="acordeao-conteudo"><p>O questionário ajuda a reduzir a chance de conexões incompatíveis. Ele foi desenhado para entender suas preferências e o que você busca na terapia, aumentando a chance de você encontrar alguém com quem realmente se conecte.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">Minhas respostas no questionário são confidenciais?</button><div class="acordeao-conteudo"><p>Sim, totalmente. Suas respostas são usadas apenas pelo sistema de recomendação da plataforma para o "match" e não são compartilhadas com os psicólogos. O que você compartilha na terapia é uma conversa privada entre você e o profissional.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">Quantos profissionais vou receber como recomendação?</button><div class="acordeao-conteudo"><p>Para evitar a "paralisia da escolha", nossa plataforma apresenta no máximo 3 profissionais que mais se alinham com suas respostas. Acreditamos na qualidade acima da quantidade.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">E se eu não encontrar nenhum profissional compatível?</button><div class="acordeao-conteudo"><p>Se não encontrarmos um "match" ideal, nossa plataforma te mostrará perfis "próximos", explicando as semelhanças e diferenças. Você também terá a opção de ser notificado(a) assim que um profissional com seu perfil exato se cadastrar.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">Posso escolher um profissional diretamente, sem o questionário?</button><div class="acordeao-conteudo"><p>O questionário é obrigatório porque melhora significativamente a qualidade das recomendações. Ele nos ajuda a entender o seu momento e as suas necessidades, garantindo indicações muito mais assertivas para a sua jornada.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">O que acontece depois que eu recebo os resultados?</button><div class="acordeao-conteudo"><p>Você verá os perfis recomendados e, ao clicar, terá acesso a todas as informações do psicólogo. Se sentir que é uma boa conexão, haverá um botão para iniciar o contato diretamente pelo WhatsApp do profissional.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">As sessões de terapia são feitas na plataforma Yelo?</button><div class="acordeao-conteudo"><p>Não. A Yelo é a ponte que conecta você ao profissional. O agendamento, o pagamento e as sessões são combinados diretamente entre você e o psicólogo, com total autonomia.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">Como posso avaliar um profissional?</button><div class="acordeao-conteudo"><p>Após iniciar o contato, você pode deixar uma avaliação diretamente na página pública do profissional. Para garantir autenticidade e segurança, a validação é feita através da sua conta Google.</p></div></div>
                    </div>
                </div>

                <div class="faq-categoria">
                    <h2 class="titulo-secao-menor">Para Profissionais (Psicólogos)</h2>
                    <div class="acordeao-container">
                        <div class="acordeao-item"><button class="acordeao-titulo">Quem pode se cadastrar na Yelo?</button><div class="acordeao-conteudo"><p>A Yelo é exclusiva para psicólogas e psicólogos com CRP ativo no Brasil. A verificação de credenciais é uma etapa obrigatória do nosso processo de cadastro.</p></div></div>                        
                        <div class="acordeao-item"><button class="acordeao-titulo">Como funciona o processo de cadastro?</button><div class="acordeao-conteudo"><p>Primeiro, você realiza um pré-cadastro. Nosso sistema analisa a demanda atual para o seu perfil profissional. Havendo compatibilidade, você é convidado(a) a concluir o cadastro na plataforma. Caso contrário, seu perfil entra na lista de espera até a abertura de novas vagas compatíveis.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">Por que existe uma lista de espera?</button><div class="acordeao-conteudo"><p>A lista de espera evita a saturação de profissionais na plataforma, garantindo que os psicólogos ativos recebam um volume equilibrado de contatos qualificados.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">Quais são os planos e o que cada um oferece?</button><div class="acordeao-conteudo"><p>Oferecemos três planos em condição especial de lançamento: <strong>Essencial (R$ 99/mês)</strong> com até 5 contatos iniciados; <strong>Clínico (R$ 159/mês)</strong> com até 15 contatos iniciados e acesso a workshops; e <strong>Referência (R$ 259/mês)</strong> com até 30 contatos iniciados e acesso total a todos os recursos.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">O que conta como um contato iniciado?</button><div class="acordeao-conteudo"><p>Um contato é contabilizado apenas quando o paciente clica para iniciar conversa no seu WhatsApp. Limitamos o número de contatos por plano para garantir uma distribuição equilibrada entre os profissionais da plataforma. Ao atingir o limite do plano, o perfil deixa de aparecer temporariamente nos resultados até a renovação da assinatura ou upgrade do plano.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">Tenho acesso às respostas do questionário do paciente?</button><div class="acordeao-conteudo"><p>Não. Por razões de privacidade e ética (LGPD), as respostas do questionário são confidenciais e usadas apenas pelo sistema de recomendação da plataforma. O primeiro contato é o momento para você iniciar sua própria avaliação (anamnese).</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">A Yelo interfere nos meus honorários, pagamentos ou forma de atender?</button><div class="acordeao-conteudo"><p>Não. Você tem total autonomia sobre seu valor, agenda, abordagem e condução das sessões. <strong>Receba 100% do valor da consulta diretamente do paciente, sem pagar taxas ou comissões para a plataforma.</strong> Você é livre para cobrar por sessão avulsa, pacotes mensais e escolher a forma de pagamento (PIX, cartão, etc). Utilize nosso painel exclusivo apenas para organizar seus recebimentos e ter previsibilidade financeira.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">A Yelo é uma plataforma nova?</button><div class="acordeao-conteudo"><p>Sim! A Yelo é uma plataforma recém-lançada. Justamente por estarmos em fase de lançamento, você notará uma crescente movimentação em nossas redes, e estamos oferecendo condições especiais para os primeiros profissionais. Estamos ampliando gradualmente os investimentos em aquisição de pacientes. Nosso foco atual é crescer de forma sustentável, mantendo a qualidade das conexões e da experiência dos profissionais na plataforma.</p></div></div>
                        <div class="acordeao-item"><button class="acordeao-titulo">O que é a Comunidade Yelo?</button><div class="acordeao-conteudo"><p>É um espaço exclusivo para os profissionais da nossa rede, com canais de discussão, workshops, grupos de supervisão e intervisão para apoiar seu desenvolvimento profissional contínuo.</p></div></div>
                    </div>
                </div>

                <div class="faq-cta">
                    <h3>Ainda com dúvidas?</h3>
                    <p>Nossa equipe está pronta para te ajudar. Entre em contato conosco.</p>
                    <a href="/contato" class="btn-verde">Fale Conosco</a>
                </div>

            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            const buscaInput = document.getElementById('faq-busca');
            const categorias = document.querySelectorAll('.faq-categoria');
            const itensAcordeao = document.querySelectorAll('.acordeao-item');

            // 1. Lógica do Acordeão (Moderna, guiada por CSS Grid)
            itensAcordeao.forEach(item => {
                // Evento no card inteiro permite clicar em qualquer lugar
                item.addEventListener('click', (e) => {
                    // Ignora se o clique for no texto interno (permite que o usuário copie a resposta)
                    if (e.target.closest('.acordeao-conteudo')) return;

                    const isAtivo = item.classList.contains('ativo');
                    
                    // Fecha todos de forma fluida
                    itensAcordeao.forEach(i => {
                        i.classList.remove('ativo');
                        const tituloEl = i.querySelector('.acordeao-titulo');
                        if (tituloEl) tituloEl.classList.remove('ativo');
                    });

                    // Se estava fechado, abre o atual
                    if (!isAtivo) {
                        item.classList.add('ativo');
                        const tituloEl = item.querySelector('.acordeao-titulo');
                        if (tituloEl) tituloEl.classList.add('ativo');
                    }
                });
            });

            // 2. Lógica de Pesquisa (com Debounce para otimização)
            if (buscaInput) {
                let timeoutId;

                buscaInput.addEventListener('input', (e) => {
                    clearTimeout(timeoutId);
                    const termoBusca = e.target.value.toLowerCase().trim();

                    timeoutId = setTimeout(() => {
                        categorias.forEach(categoria => {
                            let categoriaTemResultados = false;
                            const itens = categoria.querySelectorAll('.acordeao-item');

                            itens.forEach(item => {
                                const titulo = item.querySelector('.acordeao-titulo')?.textContent.toLowerCase() || '';
                                const conteudo = item.querySelector('.acordeao-conteudo')?.textContent.toLowerCase() || '';

                                if (titulo.includes(termoBusca) || conteudo.includes(termoBusca)) {
                                    item.style.display = '';
                                    categoriaTemResultados = true;
                                } else {
                                    item.style.display = 'none';
                                    // Remove a classe ativo caso ele estivesse aberto
                                    item.classList.remove('ativo');
                                    const tituloEl = item.querySelector('.acordeao-titulo');
                                    if (tituloEl) tituloEl.classList.remove('ativo');
                                }
                            });

                            // Oculta a categoria inteira se nenhum item for encontrado
                            categoria.style.display = categoriaTemResultados ? '' : 'none';
                        });
                    }, 200); // Aguarda 200ms para evitar engasgos ao digitar rapidamente
                });
            }
        });
    </script>
</body>
</html>