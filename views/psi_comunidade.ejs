<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Comunidade Q&A - Yelo</title>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header') %>

    <main class="container" style="padding-top: 120px; padding-bottom: 60px;">
        <div class="main-header">
            <h1>Comunidade Q&A</h1>
        </div>
        <div id="qna-main-view">

        <!-- Alerta de Novas Perguntas -->
        <div id="qna-new-questions-alert" style="display:none; background:#e0f2fe; color:#0284c7; padding:15px 20px; border-radius:12px; margin-bottom:25px; font-weight:600; cursor:pointer; text-align:center; border: 1px solid #bae6fd; box-shadow: 0 4px 10px rgba(2, 132, 199, 0.05);" onclick="document.querySelector('.tab-item[data-filter=\\'pending\\']')?.click(); this.style.display='none';">
        </div>

        <div class="qna-container-admin" id="qna-list-container">
            <div class="loader-wrapper">
                <div class="loader-spinner"></div>
            </div>
        </div>
        </div>

        <!-- View de Detalhes da Pergunta -->
        <div id="qna-details-view" style="display: none; animation: fadeIn 0.3s ease;">
            <button id="btn-back-qna" class="btn btn-secundario" style="margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                Voltar para as perguntas
            </button>
            
            <div id="qna-details-question-container"></div>
            
            <h3 style="margin-top: 30px; margin-bottom: 15px; color: var(--verde-escuro); border-bottom: 1px solid #eee; padding-bottom: 10px;">Todas as Respostas</h3>
            <div id="qna-details-answers-list" class="existing-answers-list" style="display: flex; flex-direction: column; gap: 15px;"></div>
            
            <div style="text-align: center; margin-top: 25px; margin-bottom: 30px;">
                <button id="btn-load-more-answers" class="btn btn-secundario" style="display: none; padding: 10px 24px; border-radius: 50px;">Carregar mais respostas</button>
            </div>
        </div>

        <div id="qna-answer-modal" class="modal-overlay">
            <div class="modal-content">
                <button class="modal-close">&times;</button>
                <div class="modal-header">
                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                        <h2 class="modal-title" style="margin: 0;">Responder Pergunta</h2>
                        <button type="button" id="btn-generate-ai-qna" class="btn hidden" style="padding: 5px 14px; font-size: 0.82rem; min-width: 0; width: auto; border-radius: 50px; margin: 0; background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; box-shadow: 0 2px 6px rgba(16,185,129,0.3); display: flex; align-items: center; gap: 5px; cursor: pointer;" title="Gerar rascunho com IA">✨ IA</button>
                    </div>
                </div>
                <form id="qna-answer-form">
                    <div class="modal-body">
                        <textarea id="qna-answer-textarea" minlength="50" required placeholder="Sua resposta..."></textarea>
                        <div id="qna-char-counter" style="text-align: right; font-size: 0.85rem; color: #888; margin-top: 5px;">0/50 caracteres mínimos</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secundario modal-cancel">Cancelar</button>
                        <button type="submit" id="btn-enviar-resposta" class="btn btn-principal" disabled>Enviar</button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script nonce="<%= nonce %>">
        document.addEventListener('DOMContentLoaded', () => {
            const textarea = document.getElementById('qna-answer-textarea');
            const counter = document.getElementById('qna-char-counter');
            const btnSubmit = document.getElementById('btn-enviar-resposta');

            if (textarea && counter && btnSubmit) {
                textarea.addEventListener('input', function() {
                    const len = this.value.length;
                    counter.textContent = `${len}/50 caracteres mínimos`;
                    
                    // Habilita o botão apenas se atingir o mínimo de 50 caracteres
                    btnSubmit.disabled = len < 50;
                    counter.style.color = len >= 50 ? '#1B4332' : '#888';
                });
            }
        });
    </script>

    <%- include('partials/footer') %>
</body>
</html>