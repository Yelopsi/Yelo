<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Nossos Profissionais | Yelo</title>
    <meta name="description" content="Conheça a rede de psicólogos da Yelo. Profissionais verificados, diversos e qualificados prontos para te acolher.">
    <%- include('partials/head') %>
    <style>
        /* --- ESTÉTICA ORGÂNICA (Baseada na Home) --- */
        
        /* Doodles de Fundo */
        .doodle-bg {
            position: absolute;
            opacity: 0.6;
            pointer-events: none;
            z-index: 1;
            color: #e0e0e0;
        }
        .doodle-bg.left { top: 5%; left: -50px; width: 300px; transform: rotate(45deg); }
        .doodle-bg.right { bottom: 5%; right: -50px; width: 250px; transform: rotate(-45deg); }
        .doodle-bg.top-right { top: 10%; right: -30px; width: 180px; transform: rotate(120deg); opacity: 0.4; }

        /* Hero */
        .hero-psis {
            padding: 80px 20px 120px; /* Mais espaço embaixo para a wave */
            text-align: center;
            background-color: #fdfaf6;
            position: relative;
            overflow: hidden;
            margin-top: -2px;
        }

        .hero-psis h1 {
            color: #1B4332;
            margin-bottom: 20px;
            font-family: var(--font-titulos);
            font-size: 3rem;
            position: relative;
            z-index: 2;
        }

        .hero-psis p {
            max-width: 700px;
            margin: 0 auto;
            font-size: 1.2rem;
            color: #555;
            line-height: 1.6;
            position: relative;
            z-index: 2;
        }

        /* Seção de Qualidade (Cards Orgânicos) */
        .quality-section {
            padding: 50px 20px;
            background: #fff;
            position: relative;
        }

        .quality-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 40px;
            max-width: 1100px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }

        .quality-card {
            background: #fff;
            padding: 40px 30px;
            border-radius: 24px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid #f0f0f0;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .quality-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            border-color: var(--verde-escuro);
        }

        /* Header do Card (Ícone + Título) */
        .card-header-flex {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .quality-icon {
            font-size: 2rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 55px;
            height: 55px;
            background: #f0fdf4;
            color: #16a34a;
            border-radius: 16px;
            flex-shrink: 0;
        }
        .quality-card:nth-child(2) .quality-icon { background: #fffbeb; color: #b45309; }
        .quality-card:nth-child(3) .quality-icon { background: #f3e8ff; color: #7e22ce; }

        .quality-card h3 {
            color: #1B4332;
            margin: 0;
            font-family: var(--font-titulos);
            font-size: 1.3rem;
            line-height: 1.2;
        }
        
        .quality-card p {
            font-family: var(--font-principal);
            font-size: 1rem;
            color: #555;
            line-height: 1.6;
            margin: 0;
        }

        /* --- SEÇÃO COLLAGE (Nova - Estilo Index) --- */
        .collage-section {
            padding: 60px 20px 80px;
            background-color: #F8F3ED; /* Creme suave */
            position: relative;
            overflow: hidden;
        }
        
        .container-collage {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
            position: relative;
            z-index: 2;
        }

        .collage-text h2 {
            font-family: var(--font-titulos);
            font-size: 2.8rem;
            color: #1B4332;
            line-height: 1.1;
            margin-bottom: 25px;
        }
        
        .collage-text p {
            font-size: 1.15rem;
            line-height: 1.7;
            color: #555;
            margin-bottom: 30px;
        }

        .collage-wrapper {
            position: relative;
            width: 100%;
            height: auto;
        }


        /* --- CTA FINAL --- */
        .cta-final-psi {
            padding: 80px 20px;
            text-align: center;
            background: #fff;
        }
        .cta-final-psi h2 {
            font-family: var(--font-titulos);
            color: var(--verde-escuro);
            font-size: 2.2rem;
            margin-bottom: 20px;
        }
        .cta-final-psi p {
            font-size: 1.1rem;
            color: #666;
            margin-bottom: 30px;
            line-height: 1.6;
        }

        /* Wave Dividers */
        .wave-divider {
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            line-height: 0;
            z-index: 2;
        }
        .wave-top {
            position: absolute;
            top: -1px;
            left: 0;
            width: 100%;
            line-height: 0;
            transform: rotate(180deg);
            z-index: 1;
        }

        .mobile-scroll-hint {
            display: none;
        }

        @media (max-width: 768px) {
            .container-collage { grid-template-columns: 1fr; text-align: center; }
            .collage-wrapper { height: auto; margin-top: 40px; }
            .hero-psis h1 { font-size: 2.5rem; }

            /* Scroll Snap Horizontal para Cards no Mobile */
            .quality-grid {
                display: flex;
                overflow-x: auto;
                scroll-snap-type: x mandatory;
                gap: 15px;
                padding-bottom: 20px; /* Espaço para scroll */
                /* Remove grid layout */
                grid-template-columns: none;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: none; /* Firefox */
            }
            .quality-grid::-webkit-scrollbar { display: none; } /* Chrome/Safari */
            
            .quality-card {
                flex: 0 0 85%; /* Mostra 85% do card para incentivar scroll */
                scroll-snap-align: center;
                min-width: 280px;
            }

            /* Dica de Scroll Mobile */
            .mobile-scroll-hint {
                display: flex;
                align-items: center;
                justify-content: center;
                margin-top: 15px;                
            }
            .mobile-scroll-hint .mouse {
                width: 26px;
                height: 42px;
                border: 2px solid #1B4332;
                border-radius: 20px;
                display: block;
                position: relative;
                transform: rotate(90deg);
            }
            
            .mobile-scroll-hint .wheel {
                width: 4px;
                height: 4px;
                background: #1B4332;
                border-radius: 50%;
                position: absolute;
                top: 8px;
                left: 50%;
                transform: translateX(-50%);
                animation: scrollWheel 1.5s infinite;
            }
            
            @keyframes scrollWheel {
                0% { top: 8px; opacity: 1; }
                100% { top: 25px; opacity: 0; }
            }
        }
    </style>
</head>
