    </div>
</header>
<script nonce="<%= nonce %>">
    document.addEventListener('DOMContentLoaded', () => {
        const path = window.location.pathname;
        const registerBtn = document.getElementById('header-register-btn');
        if (registerBtn && (path === '/profissionais' || path === '/sobre_psis' || path.startsWith('/profissionais/'))) {
            registerBtn.href = '/psi_questionario.html';
        }
    });
</script>

