<!-- Polyfills de Tracking para evitar erros de scripts soltos na página -->
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  window.gtag = window.gtag || gtag;
  function fbq(){
      if(window.fbq && window.fbq.callMethod) { window.fbq.apply(window, arguments); } 
      else { window._fbqQueue = window._fbqQueue || []; window._fbqQueue.push(arguments); }
  }
</script>

<script src="/js/consent-manager.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        let uid = null;
        <% if (typeof user !== 'undefined' && user && user.id) { %>
            uid = '<%= user.id %>';
        <% } else if (typeof userDecoded !== 'undefined' && userDecoded && userDecoded.id) { %>
            uid = '<%= userDecoded.id %>';
        <% } %>
        
        window.ConsentManager.injectGTAG(['G-5NFD83MGSM', 'AW-11236864912', 'AW-783735995'], uid);
        window.ConsentManager.injectMetaPixel(['1809040407133168']);
        
        window.ConsentManager.onAnalyticsConsent(() => {
            if(document.getElementById('yelo-clarity')) return;
            (function(c,l,a,r,i,t,y){
                c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
                t=l.createElement(r);t.async=1;t.id='yelo-clarity';t.src="https://www.clarity.ms/tag/"+i;
                y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "whxuoctqbz");
        });
    });
</script>