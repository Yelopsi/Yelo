    <%- include('partials/head') %>
    <style>
        /* --- ESTILOS ESPECÍFICOS DA LANDING PAGE PSI --- */
        
        /* Hero Section */
        .hero-psi {
            padding: 100px 20px 140px;
            background-color: #1B4332;
            color: #fff;
            position: relative;
            overflow: hidden;
            margin-top: -2px;
            text-align: center;
        }

        .hero-psi h1 {
            font-family: var(--font-titulos);
            font-size: 3.5rem;
            line-height: 1.1;
            margin-bottom: 20px;
            color: #fff;
        }

        .hero-psi p {
            font-size: 1.25rem;
            max-width: 700px;
            margin: 0 auto 40px;
            opacity: 0.9;
            line-height: 1.6;
        }

        /* Doodles Hero */
        .doodle-hero {
            position: absolute;
            opacity: 0.15;
            pointer-events: none;
        }
        .doodle-hero.left { top: 10%; left: -5%; width: 300px; transform: rotate(15deg); }
        .doodle-hero.right { bottom: 20%; right: -5%; width: 250px; transform: rotate(-15deg); }

        /* Seção de Números (Prova Social) */
        .stats-section {
            background-color: #fff;
            padding: 60px 20px;
            position: relative;
            z-index: 2;
            margin-top: 0; /* Ajuste para não cobrir a wave */
        }

        /* Ajuste de cores alternadas para o fluxo das ondas */
        .jornada-section { background-color: #fdfaf6 !important; }
        .benefits-section { background-color: #fff !important; }
        .diferenciais-section { background-color: #fdfaf6 !important; }
        .match-section { background-color: #fff !important; }
        .faq-psi-section { background-color: #fdfaf6 !important; }
        .plans-section { background-color: #1B4332 !important; color: #fff; }


        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
            max-width: 1000px;
            margin: -100px auto 0; /* Card flutuando sobre a hero */
            background: #fff;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.08);
            border: 1px solid rgba(0,0,0,0.05);
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            display: block;
            font-family: var(--font-titulos);
            font-size: 2.5rem;
            color: #1B4332;
            font-weight: 700;
        }

        .stat-label {
            font-size: 1rem;
            color: #666;
            font-weight: 500;
        }

        /* Seção Benefícios (Grid Orgânico) */
        .benefits-section {
            padding: 100px 20px;
            background-color: #fdfaf6;
        }

        .benefits-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            max-width: 1100px;
            margin: 50px auto 0;
            justify-content: center;
        }

        .benefit-card {
            background: #fff;
            padding: 40px 30px;
            border-radius: 24px 60px 24px 60px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
            transition: transform 0.3s ease;
            border: 1px solid rgba(0,0,0,0.03);
            text-align: left;
        }
        .benefit-card:nth-child(2) { border-radius: 60px 24px 60px 24px; }
        .benefit-card:nth-child(3) { border-radius: 24px 60px 24px 60px; }

        .benefit-card:hover { transform: translateY(-10px); }

        .benefit-icon { font-size: 2.5rem; margin-bottom: 20px; display: inline-block; background: #fff; width: 70px; height: 70px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
        .benefit-card h3 { font-family: var(--font-titulos); color: #1B4332; margin-bottom: 15px; font-size: 1.4rem; }
        .benefit-card p { color: #555; line-height: 1.6; }

        /* Seção Planos */
        .plans-section {
            padding: 100px 20px;
            background-color: #1B4332;
            color: #fff;
            text-align: center;
            position: relative;
        }

        .plans-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            max-width: 1000px;
            margin: 50px auto 0;
            align-items: center; /* Alinha verticalmente */
            justify-content: center;
        }

        .plan-card {
            background: #fff;
            border: 1px solid #eee;
            border-radius: 16px;
            padding: 40px 30px;
            transition: transform 0.3s ease;
            position: relative;
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        /* Estilo Orgânico para Planos */
        .plan-card:nth-child(1) { border-radius: 24px 60px 24px 60px; }
        .plan-card:nth-child(2) { border-radius: 60px 24px 60px 24px; }
        .plan-card:nth-child(3) { border-radius: 24px 60px 24px 60px; }

        .plan-card.featured {
            border: 2px solid #1B4332;
            transform: scale(1.05);
            box-shadow: 0 15px 40px rgba(27, 67, 50, 0.1);
            z-index: 2;
            background-color: #F0FDF4;
        }

        .plan-tag {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            background-color: #1B4332;
            color: #fff;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
            text-transform: uppercase;
        }

        .plan-name { font-family: var(--font-titulos); font-size: 1.5rem; color: #333; margin-bottom: 10px; }
        .plan-price { font-size: 1.2rem; font-weight: 700; color: #1B4332; margin-bottom: 20px; opacity: 0.8; }
        .plan-price span { font-size: 1rem; color: #666; font-weight: 400; }
        
        .plan-features { list-style: none; padding: 0; margin: 0 0 30px 0; text-align: left; flex-grow: 1; }
        .plan-features li { padding: 10px 0; border-bottom: 1px solid rgba(0,0,0,0.05); color: #555; display: flex; gap: 10px; align-items: center; }
        .plan-features li::before { content: '✓'; color: #1B4332; font-weight: bold; }

        /* CTA Final */
        .cta-section {
            padding: 100px 20px;
            background-color: #ffffff;
            text-align: center;
            color: #333;
            position: relative;
            overflow: hidden;
        }

        .cta-content { position: relative; z-index: 2; max-width: 700px; margin: 0 auto; }
        .cta-section h2 { color: #1B4332; font-size: 2.5rem; margin-bottom: 20px; }
        .cta-section p { font-size: 1.2rem; opacity: 0.9; margin-bottom: 40px; color: #666; }

        /* --- DEPOIMENTOS (PROVA SOCIAL) --- */
        .depoimentos-psi-section {
            padding: 40px 20px 80px 20px;
            background-color: #fdfaf6;
            text-align: center;
        }
        .depoimentos-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            max-width: 1000px;
            margin: 40px auto 0;
        }
        .depoimento-card {
            background: #fff;
            padding: 40px 30px;
            border-radius: 24px 60px 24px 60px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.03);
            text-align: left;
            border: 1px solid rgba(0,0,0,0.03);
            position: relative;
        }
        .depoimento-card:nth-child(even) { border-radius: 60px 24px 60px 24px; }
        .depoimento-card::before {
            content: '“';
            font-family: var(--font-titulos);
            font-size: 5rem;
            color: #FFEE8C;
            position: absolute;
            top: -10px;
            left: 20px;
            opacity: 0.6;
            line-height: 1;
        }
        .depoimento-texto { font-size: 1.05rem; line-height: 1.6; color: #555; margin-top: 15px; margin-bottom: 20px; position: relative; z-index: 1; font-style: italic; }
        .depoimento-autor { display: flex; align-items: center; gap: 15px; }
        .depoimento-autor img { width: 50px; height: 50px; border-radius: 50%; object-fit: cover; border: 2px solid #fdfaf6; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .depoimento-autor div { display: flex; flex-direction: column; }
        .depoimento-autor strong { color: #1B4332; font-size: 1rem; }
        .depoimento-autor span { color: #888; font-size: 0.85rem; }

        /* --- NOVAS SEÇÕES (Jornada, Diferenciais, Match, FAQ) --- */
        
        /* Jornada (Storytelling) */
        .jornada-section {
            padding: 80px 20px;
            background-color: #fff;
            text-align: center;
            position: relative;
        }
        .texto-leitura {
            max-width: 800px;
            margin: 0 auto;
            font-size: 1.15rem;
            line-height: 1.8; /* Leitura escaneável */
            color: #555;
            text-align: left;
        }
        .texto-leitura p { margin-bottom: 20px; }

        /* Diferenciais (Grid 2x2) */
        .diferenciais-section {
            padding: 80px 20px;
            background-color: #fdfaf6;
            position: relative;
        }
        .diferenciais-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            max-width: 1000px;
            margin: 40px auto 0;
        }
        .diferencial-card {
            background: #fff;
            padding: 30px;
            border-radius: 16px;
            border: 1px solid rgba(0,0,0,0.05);
            box-shadow: 0 5px 15px rgba(0,0,0,0.03);
            transition: transform 0.3s ease;
        }
        .diferencial-card:hover { transform: translateY(-5px); }
        /* Cards Orgânicos para Diferenciais */
        .diferencial-card { border-radius: 24px 60px 24px 60px; }
        .diferencial-card:nth-child(even) { border-radius: 60px 24px 60px 24px; }
        .diferencial-card:nth-child(3) { border-radius: 24px 60px 24px 60px; }
        .diferencial-card:nth-child(4) { border-radius: 60px 24px 60px 24px; }

        .diferencial-card h3 {
            color: #1B4332;
            font-family: var(--font-titulos);
            margin-bottom: 15px;
            font-size: 1.3rem;
        }
        .diferencial-card p {
            color: #666;
            line-height: 1.6;
            font-size: 1rem;
        }

        /* Match Science */
        .match-section {
            padding: 100px 20px;
            position: relative;
            overflow: hidden;
        }
        .match-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
            max-width: 1100px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }
        .match-collage-wrapper {
            position: relative;
            height: 400px;
        }
        .match-img {
            position: absolute;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            object-fit: cover;
        }
        .match-img.main { width: 60%; height: 70%; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2; border-radius: 100px 100px 20px 20px; }
        .match-img.sat1 { width: 35%; height: 40%; top: 0; left: 0; z-index: 1; border-radius: 20px 60px 20px 60px; }
        .match-img.sat2 { width: 35%; height: 40%; bottom: 0; right: 0; z-index: 3; border-radius: 60px 20px 60px 20px; }

        @media (max-width: 992px) {
            .match-container { grid-template-columns: 1fr; text-align: center; }
            .match-collage-wrapper { margin-top: 40px; height: 300px; }
        }

        /* FAQ Section */
        .faq-psi-section {
            padding: 100px 20px;
            position: relative;
        }
        .acordeao-container { max-width: 800px; margin: 0 auto; text-align: left; }
        .acordeao-item {
            background-color: #fff;
            border-radius: 24px 40px 24px 40px;
            margin-bottom: 15px;
            border: 1px solid rgba(0,0,0,0.03);
            box-shadow: 0 5px 15px rgba(0,0,0,0.03);
            overflow: hidden;
            transition: transform 0.3s ease;
        }
        .acordeao-item:nth-child(even) { border-radius: 40px 24px 40px 24px; }
        .acordeao-item:hover { transform: translateY(-2px); }

        .acordeao-titulo {
            width: 100%;
            padding: 20px;
            background: none;
            border: none;
            text-align: left;
            font-family: var(--font-titulos);
            font-size: 1.1rem;
            color: #1B4332;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .acordeao-titulo::after { content: '+'; font-size: 1.5rem; font-weight: 300; }
        .acordeao-titulo.ativo::after { transform: rotate(45deg); }
        .acordeao-conteudo {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        .acordeao-conteudo p { padding: 0 20px 20px; color: #555; line-height: 1.6; margin: 0; }

        /* Wave Dividers */
        .wave-divider {
            position: absolute;
            left: 0;
            width: 100%;
            line-height: 0;
            z-index: 1;
        }
        .wave-top { top: -1px; transform: rotate(180deg); }
        .wave-bottom { bottom: -1px; }

        .wave-divider svg {
            display: block;
            width: 100%;
            height: 120px;
        }

        /* Mobile Scroll Hint & Floating CTA */
        .mobile-scroll-hint { display: none; }

        /* Responsividade e Ajustes Desktop */
        @media (min-width: 992px) {
            /* Força 3 colunas lado a lado no desktop */
            .benefits-grid, .plans-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 991px) {
            .hero-psi h1 { font-size: 2.5rem; }
            .stats-grid { grid-template-columns: 1fr; gap: 20px; padding: 30px; }
            .plan-card.featured { transform: none; margin: 20px 0; }
            .cta-section { padding-bottom: 100px; } /* Espaço para o botão flutuante */

            /* Scroll Snap Horizontal para Cards no Mobile */
            .benefits-grid, .plans-grid, .diferenciais-grid {
                display: flex;
                overflow-x: auto;
                scroll-snap-type: x mandatory;
                gap: 15px;
                padding-bottom: 20px;
                grid-template-columns: none;
                -webkit-overflow-scrolling: touch;
                scrollbar-width: none;
                justify-content: flex-start;
            }
            .benefits-grid::-webkit-scrollbar, .plans-grid::-webkit-scrollbar, .diferenciais-grid::-webkit-scrollbar { display: none; }
            
            .benefit-card, .plan-card, .diferencial-card {
                flex: 0 0 85%;
                scroll-snap-align: center;
                min-width: 280px;
            }

            /* Dica de Scroll Mobile (Mouse) */
            .mobile-scroll-hint {
                display: flex; align-items: center; justify-content: center; margin-top: 15px;
            }
            .mobile-scroll-hint .mouse {
                width: 26px; height: 42px; border: 2px solid #1B4332; border-radius: 20px; display: block; position: relative; transform: rotate(90deg);
            }
            .mobile-scroll-hint .wheel {
                width: 4px; height: 4px; background: #1B4332; border-radius: 50%; position: absolute; top: 8px; left: 50%; transform: translateX(-50%); animation: scrollWheel 1.5s infinite;
            }
            @keyframes scrollWheel {
                0% { top: 8px; opacity: 1; }
                100% { top: 25px; opacity: 0; }
            }
        }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <main>
        <!-- HERO -->
        <section class="hero-psi">
            <svg class="doodle-hero left" viewBox="0 0 200 200" fill="currentColor"><path d="M45.7,-76.3C58.9,-69.3,69.1,-55.6,76.3,-41.2C83.5,-26.8,87.7,-11.7,85.6,2.6C83.5,16.9,75.1,30.4,65.6,42.2C56.1,54,45.5,64.1,33.3,70.3C21.1,76.5,7.3,78.8,-5.3,76.9C-17.9,75,-34.7,68.9,-48.6,59.6C-62.5,50.3,-73.5,37.8,-79.6,23.3C-85.7,8.8,-86.9,-7.7,-80.7,-21.8C-74.5,-35.9,-60.9,-47.6,-46.8,-54.3C-32.7,-61,-18.1,-62.7,-2.9,-62.2C12.3,-61.7,24.6,-59,32.5,-83.3L45.7,-76.3Z" transform="translate(100 100)" /></svg>
            <svg class="doodle-hero right" viewBox="0 0 200 200" fill="currentColor"><path d="M38.1,-63.8C49.3,-54.6,58.3,-43.3,65.5,-30.8C72.7,-18.3,78.1,-4.6,76.3,8.3C74.5,21.2,65.5,33.3,55.3,43.4C45.1,53.5,33.7,61.6,21.1,66.1C8.5,70.6,-5.3,71.5,-18.4,67.8C-31.5,64.1,-43.9,55.8,-53.4,45.2C-62.9,34.6,-69.5,21.7,-70.8,8.2C-72.1,-5.3,-68.1,-19.4,-59.6,-31.1C-51.1,-42.8,-38.1,-52.1,-25.3,-60.1C-12.5,-68.1,0.1,-74.8,12.7,-74.8C25.3,-74.8,38.1,-68.1,38.1,-63.8Z" transform="translate(100 100)" /></svg>

            <div class="container" style="padding-bottom: 0;">
                <h1>Viva da Psicologia com autonomia e segurança</h1>
                <p>A Yelo conecta você a pacientes que buscam exatamente a sua abordagem. Simplifique sua gestão, receba pagamentos garantidos e foque no que importa: o atendimento.</p>
                <a href="/psi_questionario.html" class="btn-cta-principal" style="background-color: #FFEE8C; color: #1B4332;">Criar meu perfil profissional</a>
            </div>

            <div class="wave-divider wave-bottom">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
                    <path fill="#ffffff" fill-opacity="1" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,112C672,96,768,96,864,112C960,128,1056,160,1152,165.3C1248,171,1344,149,1392,138.7L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
                </svg>
            </div>
        </section>

        <!-- STATS -->
        <section class="stats-section">
            <div class="stats-grid">
                <div class="stat-item">
                    <span class="stat-number" data-count="100" data-suffix="%">0%</span>
                    <span class="stat-label">Sigilo e Privacidade Absoluta</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number" data-count="1" data-suffix="º">0º</span>
                    <span class="stat-label">Seu Bem-Estar em 1º Lugar</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number" data-count="100" data-suffix="%">0%</span>
                    <span class="stat-label">Profissionais Verificados</span>
                </div>
            </div>
            
            <div class="wave-divider wave-bottom">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
                    <path fill="#fdfaf6" fill-opacity="1" d="M0,224L48,213.3C96,203,192,181,288,181.3C384,181,480,203,576,224C672,245,768,267,864,261.3C960,256,1056,224,1152,213.3C1248,203,1344,213,1392,218.7L1440,224L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
                </svg>
            </div>
        </section>

        <!-- JORNADA DO PROFISSIONAL (Storytelling) -->
        <section class="jornada-section">
            <div class="container">
                <h2 class="titulo-secao">Do consultório vazio à gestão de alta performance</h2>
                <div class="texto-leitura">
                    <p>Sabemos que a faculdade nos prepara para a clínica, mas não para o mercado. Muitos psicólogos iniciam sua jornada divididos entre o desejo de ajudar e a burocracia de captar pacientes, cobrar sessões e gerir faltas. A Yelo nasce para eliminar esse ruído.</p>
                    <p>Imagine não precisar mais enviar mensagens de cobrança constrangedoras ou passar horas tentando configurar anúncios no Google. Nós cuidamos da infraestrutura digital para que sua única preocupação seja o acolhimento e o manejo clínico.</p>
                </div>
            </div>
            
            <div class="wave-divider wave-bottom">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
                    <path fill="#ffffff" fill-opacity="1" d="M0,224L48,213.3C96,203,192,181,288,181.3C384,181,480,203,576,224C672,245,768,267,864,261.3C960,256,1056,224,1152,213.3C1248,203,1344,213,1392,218.7L1440,224L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
                </svg>
            </div>
        </section>

        <!-- BENEFÍCIOS -->
        <section class="benefits-section" style="background-color: #fff;">
            <div class="container">
