    <!-- Script básico para animação de scroll (Reaproveitado do index) -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visivel');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.hidden').forEach((el) => observer.observe(el));

            // Acordeão FAQ
            document.querySelectorAll('.acordeao-titulo').forEach(button => {
                button.addEventListener('click', () => {
                    const expanded = button.getAttribute('aria-expanded') === 'true' || false;
                    button.setAttribute('aria-expanded', !expanded);
                    button.classList.toggle('ativo');
                    const content = button.nextElementSibling;
                    if (button.classList.contains('ativo')) {
                        content.style.maxHeight = content.scrollHeight + "px";
                    } else {
                        content.style.maxHeight = null;
                    }
                });
            });
        });
    </script>

    <!-- RASTREAMENTO YELO FUNIL (UTMs e Visita Inicial) -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            try {
                const urlParams = new URLSearchParams(window.location.search);
                const source = urlParams.get('utm_source');
                const medium = urlParams.get('utm_medium');
                const campaign = urlParams.get('utm_campaign');
                
                let utms = JSON.parse(localStorage.getItem('yelo_global_utms') || '{"source":"direto"}');
                
                // Só atualiza se veio de algum lugar
                if (source || medium) {
                    utms = { source: source || '', medium: medium || '', campaign: campaign || '' };
                    localStorage.setItem('yelo_global_utms', JSON.stringify(utms));
                }

                fetch('/api/tracking/visit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        page: window.location.pathname, utm_source: utms.source, utm_medium: utms.medium, utm_campaign: utms.campaign
                    })
                }).catch(() => {});
            } catch(e) {}
        });
    </script>
