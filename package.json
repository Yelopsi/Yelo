{
  "name": "yelo-app",
  "version": "1.0.0",
  "description": "Plataforma de Saude Mental Yelo - MVP",
  "main": "backend/server.js",
  "scripts": {
    "start": "cd backend && npx sequelize-cli db:migrate && cd .. && node backend/server.js",
    "prestart": "npm run security:gate",
    "prebuild": "npm run security:gate",
    "dev": "NODE_ENV=development nodemon backend/server.js",
    "test": "node testar-match.js",
    "deploy": "npm run security:gate && echo '✅ Verificações locais concluídas. Executando git push...' && git push origin main",
    "security:gate": "node security/gate.js",
    "postinstall": "cd backend && npm install && cd .. && npx puppeteer browsers install chrome && npm run security:gate",
    "lint": "eslint .",
    "investigate-psychologist": "node scripts/investigate_psychologist_charge.js"
  },
  "keywords": [
    "yelo",
    "saude-mental"
  ],
  "author": "Equipe Yelo",
  "license": "ISC",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "multer-storage-cloudinary": {
      "cloudinary": "$cloudinary"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "puppeteer": "^22.6.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.1",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "nodemon": "^3.1.0",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2"
  }
}
