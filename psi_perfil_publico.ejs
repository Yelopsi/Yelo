<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= psicologo.nome %> | Yelo</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="<%- psicologo.bio ? psicologo.bio.substring(0, 155) + '...' : 'Encontre apoio emocional com psicólogos qualificados na Yelo. Terapia online acessível e segura.' %>">
    <meta name="keywords" content="psicólogo, terapia online, <%= psicologo.nome %>, <%= psicologo.temas_atuacao ? psicologo.temas_atuacao.join(', ') : '' %>">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.yelopsi.com.br/<%= psicologo.slug %>">
    <meta property="og:title" content="<%= psicologo.nome %> | Psicólogo(a) na Yelo">
    <meta property="og:description" content="<%- psicologo.bio ? psicologo.bio.substring(0, 155) + '...' : 'Veja o perfil e agende uma conversa.' %>">
    <meta property="og:image" content="<%= psicologo.fotoUrl %>">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://www.yelopsi.com.br/<%= psicologo.slug %>">
    <meta property="twitter:title" content="<%= psicologo.nome %> | Psicólogo(a) na Yelo">
    <meta property="twitter:description" content="<%- psicologo.bio ? psicologo.bio.substring(0, 155) + '...' : 'Veja o perfil e agende uma conversa.' %>">
    <meta property="twitter:image" content="<%= psicologo.fotoUrl %>">

    <!-- Favicon e Estilos -->
    <link rel="icon" href="/assets/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/css/01-variables.css">
    <link rel="stylesheet" href="/css/02-base.css">
    <link rel="stylesheet" href="/css/03-components.css">
    <link rel="stylesheet" href="/css/04-layout.css">
    <link rel="stylesheet" href="/css/05-pages.css">
    <link rel="stylesheet" href="/css/psi_dashboard.css"> <!-- Reutilizando estilos do dashboard -->
</head>
<body class="pagina-perfil-publico">

    <%- include('../views/partials/header_publico') %>

    <main class="profile-page-main">
        <div class="container">
            <div class="profile-header-grid">
                
                <!-- Coluna Esquerda: Informações Principais -->
                <div class="profile-info-main">
                    <!-- Card de Herói com Foto e Bio -->
                    <div class="profile-info">
                        <div class="profile-photo-wrapper">
                            <img src="<%= psicologo.fotoUrl || 'https://placehold.co/180x180' %>" alt="Foto de <%= psicologo.nome %>" id="psi-photo-public">
                        </div>
                        <h1><%= psicologo.nome %></h1>
                        <span class="crp">CRP: <%= psicologo.crp %></span>
                        
                        <!-- Social Proof (Estrelas) - Dados Fictícios por enquanto -->
                        <div class="hero-stars-container" style="justify-content: center; margin-bottom: 20px;">
                            <span class="stars" style="color: #FFC107;">★★★★★</span>
                            <span class="hero-rating-text">(4.9 de 50+ avaliações)</span>
                        </div>

                        <div class="social-links-profile">
                            <% if (psicologo.instagram_url) { %>
                                <a href="<%= psicologo.instagram_url %>" target="_blank" class="icon-social" title="Instagram">
                                    <%- include('../views/partials/icons/instagram.svg') %>
                                </a>
                            <% } %>
                            <% if (psicologo.linkedin_url) { %>
                                <a href="<%= psicologo.linkedin_url %>" target="_blank" class="icon-social" title="LinkedIn">
                                    <%- include('../views/partials/icons/linkedin.svg') %>
                                </a>
                            <% } %>
                        </div>
                        
                        <div class="profile-bio-hero">
                            <p id="psi-bio-text"><%- psicologo.bio || 'Este profissional ainda não adicionou uma biografia.' %></p>
                        </div>
                    </div>

                    <!-- Abas de Conteúdo -->
                    <div class="profile-body-tabs">
                        <nav class="tabs-nav">
                            <button class="tab-link active" data-tab="sobre">Sobre</button>
                            <button class="tab-link" data-tab="avaliacoes">Avaliações</button>
                            <button class="tab-link" data-tab="agenda">Agenda</button>
                        </nav>
                        <div class="tab-content active" id="tab-sobre">
                            <h3>Especialidades e Temas</h3>
                            <div class="practices-container">
                                <% if (psicologo.temas_atuacao && psicologo.temas_atuacao.length > 0) { %>
                                    <% psicologo.temas_atuacao.forEach(tema => { %>
                                        <span class="practice-tag"><%= tema %></span>
                                    <% }); %>
                                <% } else { %>
                                    <p>Nenhum tema de atuação informado.</p>
                                <% } %>
                            </div>
                            <h3 style="margin-top: 30px;">Abordagem Técnica</h3>
                            <div class="practices-container">
                                <% if (psicologo.abordagens_tecnicas && psicologo.abordagens_tecnicas.length > 0) { %>
                                     <% psicologo.abordagens_tecnicas.forEach(abordagem => { %>
                                        <span class="practice-tag" style="background-color: #e8f5e9;"><%= abordagem %></span>
                                    <% }); %>
                                <% } else { %>
                                    <p>Nenhuma abordagem informada.</p>
                                <% } %>
                            </div>
                        </div>
                        <div class="tab-content" id="tab-avaliacoes">
                            <!-- Conteúdo das Avaliações (a ser preenchido) -->
                            <p>Funcionalidade de avaliações em desenvolvimento.</p>
                        </div>
                        <div class="tab-content" id="tab-agenda">
                            <!-- Conteúdo da Agenda (a ser preenchido) -->
                             <p>Funcionalidade de agenda em desenvolvimento.</p>
                        </div>
                    </div>
                </div>

                <!-- Coluna Direita: Card de Conversão (Sticky) -->
                <div class="conversion-card-wrapper">
                    <div class="conversion-card-modern">
                        <% if (psicologo.is_exempt) { %>
                            <div class="tag-oferta-topo">✨ VIP</div>
                        <% } %>
                        
                        <div class="info-row">
                            <%- include('../views/partials/icons/money.svg') %>
                            <span>Valor da sessão</span>
                        </div>
                        
                        <div class="price-display">
                            R$ <%= psicologo.valor_sessao_numero ? psicologo.valor_sessao_numero.toFixed(2).replace('.', ',') : 'A combinar' %>
                        </div>
                        <span class="price-suffix">/ 50 minutos</span>

                        <div style="margin: 25px 0;">
                            <a href="https://wa.me/55<%= psicologo.telefone.replace(/\D/g, '') %>?text=Olá, <%= psicologo.nome.split(' ')[0] %>! Encontrei seu perfil na Yelo e gostaria de agendar uma conversa." 
                               target="_blank" 
                               id="btn-agendar-whatsapp" 
                               class="btn-pulse"
                               data-slug="<%= psicologo.slug %>">
                                <%- include('../views/partials/icons/whatsapp.svg') %>
                                Chamar no WhatsApp
                            </a>
                        </div>
                        
                        <div class="info-row">
                            <%- include('../views/partials/icons/calendar.svg') %>
                            <span>Próximo horário: <strong>Amanhã, 10:00</strong></span>
                        </div>
                        
                        <div class="trust-badges-row">
                            <div class="trust-item">
                                <%- include('../views/partials/icons/shield-check.svg') %>
                                <span>Perfil Verificado</span>
                            </div>
                            <div class="trust-item">
                                <%- include('../views/partials/icons/credit-card.svg') %>
                                <span>Pagamento Seguro</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <%- include('../views/partials/footer') %>

    <script>
        // Lógica das abas
        const tabLinks = document.querySelectorAll('.tab-link');
        const tabContents = document.querySelectorAll('.tab-content');

        tabLinks.forEach(link => {
            link.addEventListener('click', () => {
                const tabId = link.dataset.tab;

                tabLinks.forEach(l => l.classList.remove('active'));
                tabContents.forEach(c => c.classList.remove('active'));

                link.classList.add('active');
                document.getElementById('tab-' + tabId).classList.add('active');
            });
        });

        // Lógica de clique no WhatsApp (para KPI)
        const whatsappBtn = document.getElementById('btn-agendar-whatsapp');
        if (whatsappBtn) {
            whatsappBtn.addEventListener('click', () => {
                const slug = whatsappBtn.dataset.slug;
                fetch(`/api/public/psychologists/${slug}/whatsapp-click`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ /* pode enviar dados do paciente se logado */ })
                }).catch(err => console.error('Erro ao registrar clique:', err));
            });
        }
    </script>

</body>
</html>